<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    <!--
        The whole design system, built by Tailwind from
        DYS.Molargo.Shared/Shared/Styles/molargo.css. Self-hosted Archivo comes with it
        as a static web asset of the same library.
    -->
    <link rel="stylesheet" href="_content/DYS.Molargo.Shared/css/molargo.css" />

    <!-- Hand-written, outside the Tailwind build — see the note at the top of it. -->
    <link rel="stylesheet" href="_content/DYS.Molargo.Shared/css/print.css" />

    <!-- Scoped CSS for any component that uses it. Generated by the Razor SDK. -->
    <link rel="stylesheet" href="DYS.Molargo.Web.styles.css" />

    <ImportMap />
    @*
        SVG first: one file, crisp at every size a browser asks for. The 64px PNG is the
        fallback for anything that will not take an SVG favicon, and the touch icon is what
        iOS uses when the web app is saved to a home screen — Safari ignores an SVG there.

        All three are the same mark, drawn from the same geometry rather than resampled
        from each other.
    *@
    <link rel="icon" type="image/svg+xml" href="_content/DYS.Molargo.Shared/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="_content/DYS.Molargo.Shared/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="_content/DYS.Molargo.Shared/apple-touch-icon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
