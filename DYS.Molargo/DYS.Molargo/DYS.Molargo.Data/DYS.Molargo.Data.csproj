<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The data layer, shared by every head and by the API.

    A plain class library on purpose. It used to live inside DYS.Molargo.Shared, which is a
    Razor library carrying Blazor, MvvmCross and a Tailwind build target — so an API
    referencing it for a DbContext inherited a UI framework and a CSS toolchain as well.

    No database provider is referenced here, only EF Core itself. The provider is the one
    thing that genuinely differs between the device and the server: the heads add SQLite,
    the API adds Npgsql, and neither can see the other's. Referencing a provider here would
    put SQLite in the API's output and make the wrong one easy to pick up by accident.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DYS.Molargo.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DYS.Molargo.Domain\DYS.Molargo.Domain.csproj" />
  </ItemGroup>

</Project>
