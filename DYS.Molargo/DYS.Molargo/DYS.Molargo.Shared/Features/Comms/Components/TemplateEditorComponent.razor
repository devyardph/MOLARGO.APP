@using DYS.Molargo.Domain
@using DYS.Molargo.Shared.Features.Comms.ViewModels

@*
    The design's two-column template pane: the list on the left, the editor on the right.

    The design's right column is a bare textarea and a row of merge-field chips. This adds
    a live preview rendered against a real patient with a real booking, because that is the
    only thing that answers the question the editor raises — what does this actually say
    when it goes out? A template that reads fine with tokens in it can render as "Hi , your
    appointment on  at " and nobody sees that until it has been sent.
*@

<div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr]">
    <div class="border-divider px-6 py-5 lg:border-r-2">
        <h5 class="mt-0 mb-3">Message templates</h5>

        @if (Vm.Templates.Count == 0)
        {
            <p class="text-sm text-ink/55">
                No templates. A template is a reusable body for reminders, recalls and
                campaigns, with merge fields filled in per patient at send time.
            </p>
        }
        else
        {
            <div class="flex flex-col gap-2">
                @foreach (var row in Vm.Templates)
                {
                    <button type="button"
                            class="@CommsCss.PickRow(Vm.Editing?.Id == row.TemplateId)"
                            @onclick="() => Vm.SelectTemplateCommand.ExecuteAsync(row.TemplateId)">
                        <span class="flex-1 text-[13px] font-bold">@row.Name</span>

                        @if (row.UnknownTokenCount > 0)
                        {
                            @* A template that cannot render, flagged in the list rather
                               than only on opening it. *@
                            <span class="tag tag-accent">Broken field</span>
                        }

                        @if (row.NeedsMarketingConsent)
                        {
                            <span class="tag tag-accent2">Opt-in</span>
                        }

                        <span class="tag tag-neutral">@CommsViewModel.ChannelLabel(row.Channel)</span>
                    </button>
                }
            </div>
        }
    </div>

    @if (Vm.Editing is { } template)
    {
        <div class="flex flex-col gap-3 px-6 py-5">
            <div class="flex flex-wrap items-baseline gap-2.5">
                <h5 class="m-0">@template.Name</h5>
                <span class="tag tag-neutral">@CommsViewModel.PurposeLabel(template.Purpose)</span>

                <div class="seg ml-auto">
                    @foreach (var channel in CommsViewModel.CampaignChannels)
                    {
                        <button type="button" class="@ChannelCss(channel)"
                                @onclick="() => Vm.SetTemplateChannelCommand.ExecuteAsync(channel)">
                            @CommsViewModel.ChannelLabel(channel)
                        </button>
                    }
                </div>
            </div>

            <div class="field max-w-[420px]">
                <label for="template-name">Template name</label>
                <input id="template-name" class="input"
                       @bind="Vm.TemplateName" @bind:event="oninput" />
            </div>

            @if (!Vm.IsSmsTemplate)
            {
                <div class="field max-w-[420px]">
                    <label for="template-subject">Subject</label>
                    <input id="template-subject" class="input"
                           placeholder="Shown in the patient's inbox"
                           @bind="Vm.TemplateSubject" @bind:event="oninput" />
                </div>
            }

            <div class="field">
                <label for="template-body">Message</label>
                @*
                    Bound on change, not on input. The preview is re-rendered from the
                    server on every update, and doing that per keystroke made the textarea
                    fight the cursor.
                *@
                <textarea id="template-body" class="input min-h-[110px] text-[13px]"
                          @bind="Vm.TemplateBody"
                          @bind:after="() => Vm.RefreshPreviewCommand.ExecuteAsync()"></textarea>
            </div>

            <div>
                <div class="mb-1.5 text-[10px] tracking-[0.1em] text-neutral-600 uppercase">
                    Merge fields
                </div>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var field in Vm.MergeFieldCatalogue)
                    {
                        <button type="button" class="tag tag-outline cursor-pointer"
                                title="@($"Inserts {MergeFields.Placeholder(field.Token)} — e.g. {field.Example}")"
                                @onclick="() => Vm.InsertMergeFieldCommand.ExecuteAsync(field.Token)">
                            @field.Label
                        </button>
                    }
                </div>
                <p class="mt-1.5 mb-0 text-xs text-ink/55">
                    Click one to append it. Only these are known — anything else is refused
                    on save, because an unknown field reaches the patient as literal braces.
                </p>
            </div>

            <div class="flex flex-wrap gap-2">
                <button class="btn btn-primary whitespace-nowrap"
                        disabled="@Vm.IsBusy"
                        @onclick="() => Vm.SaveTemplateCommand.ExecuteAsync()">
                    Save template
                </button>
            </div>

            @if (Vm.Preview is { } preview)
            {
                <div class="border-t-2 border-divider pt-3">
                    <div class="mb-2 flex flex-wrap items-baseline gap-2">
                        <h6 class="m-0">Preview</h6>
                        <span class="text-xs text-ink/55">
                            rendered for @preview.PatientName
                        </span>

                        @if (Vm.IsSmsTemplate && Vm.PreviewLength > 0)
                        {
                            @* Counted on the rendered text, not the template — a token is
                               twenty characters here and seven on the phone. *@
                            <span class="@SegmentCss">
                                @Vm.PreviewLength chars ·
                                @Vm.SmsSegments SMS @(Vm.SmsSegments == 1 ? "part" : "parts")
                            </span>
                        }
                    </div>

                    <div class="bg-surface p-3 text-[13px] whitespace-pre-wrap">
                        @if (preview.Subject is { Length: > 0 } subject)
                        {
                            <div class="mb-1.5 font-bold">@subject</div>
                        }
                        @preview.Body
                    </div>

                    @if (preview.Unknown.Count > 0)
                    {
                        <p class="mt-2 mb-0 text-xs font-semibold text-accent-800" role="alert">
                            Unknown merge field:
                            @string.Join(", ", preview.Unknown.Select(MergeFields.Placeholder)).
                            Saving is refused until it is removed.
                        </p>
                    }
                    else if (preview.Unresolved.Count > 0)
                    {
                        @*
                            Known fields with nothing to fill them for this patient. Not a
                            broken template — a reminder token has no value for someone
                            with no booking — but it is what the gap in the preview is, and
                            leaving it unexplained makes a working template look wrong.
                        *@
                        <p class="mt-2 mb-0 text-xs text-ink/70">
                            @string.Join(", ", preview.Unresolved.Select(Label))
                            @(preview.Unresolved.Count == 1 ? "has" : "have")
                            no value for this patient, so
                            @(preview.Unresolved.Count == 1 ? "it is" : "they are")
                            left showing above. A send would fill
                            @(preview.Unresolved.Count == 1 ? "it" : "them")
                            from the patient it goes to.
                        </p>
                    }
                </div>
            }

            <p class="mt-1 mb-0 text-xs text-ink/55">
                @*
                    The design offers "Send test". Still off, but the reason has changed:
                    both gateways now send, so a test button would work — and would send a
                    real message, at the practice's expense for a text. Worth adding with a
                    recipient box and the cost stated, not as a button that quietly spends
                    money to prove a preview.
                *@
                Templates cover SMS, email and portal messages. <strong>There is no test
                send</strong> — a test text is a real message at the practice's expense, so
                the preview above is as close as this screen gets to what the patient sees.
            </p>
        </div>
    }
    else
    {
        <div class="px-6 py-5">
            <p class="text-sm text-ink/55">Choose a template to edit it.</p>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CommsViewModel Vm { get; set; } = default!;

    /// <summary>
    /// The character count, marked once the message would bill as more than one part.
    /// </summary>
    /// <remarks>
    /// Whole literal strings, both branches — Tailwind scans source text, so a class
    /// assembled from a base plus a conditional suffix never reaches the stylesheet.
    /// </remarks>
    private string SegmentCss => Vm.SmsSegments > 1
        ? "text-xs font-semibold text-accent-800"
        : "text-xs text-ink/55";

    private string ChannelCss(CommunicationChannel channel) =>
        Vm.Editing?.Channel == channel ? "seg-opt seg-opt-on" : "seg-opt";

    /// <summary>The staff label for a token, falling back to the token itself.</summary>
    private static string Label(string token) =>
        MergeFields.Find(token)?.Label ?? token;
}
