@using DYS.Molargo.Shared.Features.Comms.ViewModels

@*
    The design's communication-preferences pane: a consent table on the left, Spam Act
    compliance on the right.

    This is the tab that is entirely real, and the one the rest of the screen depends on:
    a campaign audience is only trustworthy if the consent behind it is. Opted-out patients
    sort to the top, because they are the rows an audit is looking for and an alphabetical
    list buries them.

    The design's compliance panel is a row of ticks — unsubscribe in every message,
    opt-outs applied within seconds, quarterly audit report. Most of those describe a
    sending system that does not exist, so the panel reports what is actually true here
    instead, including what is missing.
*@

<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr]">
    <div class="border-divider px-6 py-5 lg:border-r-2">
        <div class="mb-3 flex flex-wrap items-center gap-3">
            <h5 class="m-0">Communication preferences</h5>

            @if (Vm.OptedOutCount > 0)
            {
                <span class="tag tag-accent">@Vm.OptedOutCount opted out</span>
            }

            @if (Vm.SourceMissingCount > 0)
            {
                @* Consent with no provenance. The count is here because it is the finding
                   an audit would open with. *@
                <span class="tag tag-accent2">@Vm.SourceMissingCount without a source</span>
            }

            <div class="ml-auto flex gap-2">
                <input class="input w-[200px]" placeholder="Name or patient #"
                       @bind="Vm.ConsentSearch"
                       @bind:after="() => Vm.SearchConsentCommand.ExecuteAsync()" />
            </div>
        </div>

        @if (Vm.Consent.Count == 0)
        {
            <p class="text-sm text-ink/55">
                No patients match. Consent is held per patient and per purpose — reminders
                and marketing are separate permissions.
            </p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead>
                        <tr>
                            <th class="head-cell">Patient</th>
                            <th class="head-cell">Reminders &amp; recalls</th>
                            <th class="head-cell">Marketing</th>
                            <th class="head-cell">Consent source</th>
                            <th class="head-cell">Reachable</th>
                            <th class="head-cell"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Vm.Consent)
                        {
                            <tr>
                                <td class="body-cell">
                                    <button type="button"
                                            class="cursor-pointer border-0 bg-transparent p-0 text-left font-[inherit] font-bold text-ink hover:text-accent"
                                            @onclick="() => Vm.OpenPatientCommand.Execute(row.PatientId)">
                                        @row.PatientName
                                    </button>
                                    <div class="font-mono text-[11px] text-ink/55">
                                        #@row.PatientNumber
                                    </div>
                                </td>

                                @if (Vm.IsEditingConsent(row.PatientId))
                                {
                                    <td class="body-cell" colspan="4">
                                        <div class="flex flex-col gap-2">
                                            <div class="flex flex-wrap gap-2">
                                                <button type="button"
                                                        class="@CommsCss.Chip(Vm.DraftReminderConsent)"
                                                        @onclick="() => Vm.ToggleDraftReminderCommand.Execute()">
                                                    Reminders &amp; recalls
                                                </button>
                                                <button type="button"
                                                        class="@CommsCss.Chip(Vm.DraftMarketingConsent)"
                                                        @onclick="() => Vm.ToggleDraftMarketingCommand.Execute()">
                                                    Marketing
                                                </button>
                                            </div>

                                            <div>
                                                <div class="mb-1.5 text-[10px] tracking-[0.1em] text-neutral-600 uppercase">
                                                    How it was obtained
                                                </div>
                                                <div class="flex flex-wrap gap-1.5">
                                                    @foreach (var source in CommsViewModel.ConsentSources)
                                                    {
                                                        <button type="button"
                                                                class="@CommsCss.Chip(Vm.DraftConsentSource == source)"
                                                                @onclick="() => Vm.SetConsentSourceCommand.Execute(source)">
                                                            @source
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <div class="flex gap-2">
                                                <button class="btn btn-primary text-xs whitespace-nowrap"
                                                        disabled="@Vm.IsBusy"
                                                        @onclick="() => Vm.ApplyConsentCommand.ExecuteAsync()">
                                                    Record consent
                                                </button>
                                                <button class="btn btn-ghost text-xs"
                                                        @onclick="() => Vm.CancelConsentEditCommand.Execute()">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td class="@CommsCss.ConsentCell(row.ReminderConsent)">
                                        @CommsCss.ConsentLabel(row.ReminderConsent)

                                        @if (row.ReminderUpdatedUtc is { } reminderChanged)
                                        {
                                            <div class="text-[11px] text-ink/55">
                                                @MolargoFormat.DayLabel(reminderChanged)
                                            </div>
                                        }
                                    </td>

                                    <td class="@CommsCss.ConsentCell(row.MarketingConsent)">
                                        @CommsCss.ConsentLabel(row.MarketingConsent)

                                        @if (row.MarketingUpdatedUtc is { } marketingChanged)
                                        {
                                            <div class="text-[11px]">
                                                @MolargoFormat.DayLabel(marketingChanged)
                                            </div>
                                        }
                                    </td>

                                    <td class="body-cell text-xs">
                                        @if (row.ConsentSource is { Length: > 0 } source)
                                        {
                                            @source
                                        }
                                        else if (row.SourceMissing)
                                        {
                                            @* Consent the practice cannot show the origin
                                               of is consent it cannot rely on. *@
                                            <span class="font-semibold text-accent-700">
                                                Not recorded
                                            </span>
                                        }
                                        else
                                        {
                                            @("—")
                                        }
                                    </td>

                                    <td class="body-cell text-xs">
                                        @if (row.Unreachable)
                                        {
                                            <span class="font-semibold text-accent-700">
                                                No mobile or email
                                            </span>
                                        }
                                        else
                                        {
                                            <text>
                                                @(row.HasMobile ? "SMS" : null)@(row.HasMobile && row.HasEmail ? " · " : null)@(row.HasEmail ? "Email" : null)
                                            </text>
                                        }
                                    </td>
                                }

                                <td class="body-cell">
                                    @if (!Vm.IsEditingConsent(row.PatientId))
                                    {
                                        <button class="btn btn-ghost text-xs whitespace-nowrap"
                                                @onclick="() => Vm.StartConsentEditCommand.Execute(row)">
                                            Change
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="mt-3 text-xs text-ink/55">
                Clinical and operational messages — reminders, recalls, post-op advice —
                are permitted without marketing consent. Promotions are not: they need an
                explicit opt-in, and every campaign audience on this screen enforces that.
                Withdrawing consent never asks for a source; granting it always does.
            </p>
        }
    </div>

    <div class="flex flex-col gap-3 px-6 py-5">
        <h5 class="m-0">Spam Act compliance</h5>

        @if (Vm.Activity is { } activity)
        {
            <div class="bg-surface p-3 text-[13px]">
                <strong>@activity.MarketingOptIns of @activity.TotalPatients</strong>
                patients at this location have opted in to marketing
                <div class="text-xs text-ink/55">
                    @activity.OptInRate% of the list ·
                    @activity.MarketingOptOuts opted out this month
                </div>
            </div>

            <div class="bg-surface p-3 text-[13px]">
                <strong>This month's messages</strong>
                <div class="text-xs text-ink/70">
                    @activity.Sent sent · @activity.Delivered delivered ·
                    @activity.Failed failed · @activity.Suppressed suppressed
                </div>

                @if (activity.Failed > 0)
                {
                    @* Named separately, because a bounce is a reminder the patient never
                       got and shows up weeks later as an FTA nobody can explain. *@
                    <div class="mt-1 text-xs font-semibold text-accent-800">
                        @activity.Failed did not get through — check each patient's record.
                    </div>
                }
            </div>
        }

        <div class="bg-surface p-3 text-[13px]">
            <strong>What holds today</strong>
            <div class="mt-1 text-xs text-ink/70">
                ✓ Consent held per purpose — marketing separate from reminders<br />
                ✓ Consent source and timestamp stored per change<br />
                ✓ Opt-outs excluded from every audience, with the exclusion shown<br />
                ✓ Withdrawal never blocked on a form field
            </div>
        </div>

        <div class="bg-surface p-3 text-[13px]">
            <strong>What does not</strong>
            <div class="mt-1 text-xs text-ink/70">
                @*
                    The design ticks all of these. Listing them as absent is the point: a
                    practice reading a full column of ticks would take the compliance as
                    done, and the two-way Mailchimp sync in particular is a promise about
                    other people's systems.
                *@
                ✗ No unsubscribe link or STOP handling — nothing sends, so nothing carries
                one, and a real send must not go out without it<br />
                ✗ No Mailchimp sync, so an unsubscribe there would not reach this list<br />
                ✗ No quarterly consent audit report — the table beside this is the audit<br />
                ✗ Changes here are not written to the audit trail yet
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CommsViewModel Vm { get; set; } = default!;
}
