@using DYS.Molargo.Shared.Features.Treatment.ViewModels

@*
    The design's "Accept & sign" panel.

    The design captures a drawn signature — finger or stylus on a canvas. That needs
    pointer events and a canvas through JS interop, and this app uses none anywhere, so
    what is built instead is a typed acceptance: who agreed, in what capacity, witnessed by
    the clinician presenting, timestamped. That is a real consent record. A dashed box
    saying "tap to sign" that captured nothing would look like one and not be, which is the
    worse of the two outcomes by a distance.

    Touch targets stay large — this is a tablet screen held out to somebody.
*@

<div class="flex flex-col gap-2.5">
    <h6 class="m-0">Accept &amp; sign</h6>

    @if (Vm.IsAccepted)
    {
        @* Already decided. The panel becomes the record of the decision rather than
           offering buttons that would be refused. *@
        <div class="border-2 border-neutral-900 bg-surface p-3.5">
            <div class="font-heading text-lg font-extrabold">Accepted</div>

            @if (Vm.ConsentLine is { Length: > 0 } consent)
            {
                <div class="mt-1 text-xs text-ink/55">@consent</div>
            }
        </div>

        @*
            Booking lives here because this is the moment it matters: the patient has just
            said yes and is still in the chair. Sending them to the front desk to be found
            again in the diary is how an accepted plan becomes an unbooked one.

            One button per visit rather than "book the course" — three appointments that
            merely share a plan are not a series, and a real series needs the multi-visit
            course that is not built.
        *@
        <div>
            <h6 class="mt-1 mb-2">Book the visits</h6>

            <div class="flex flex-col gap-2">
                @foreach (var visit in Vm.VisitBookings)
                {
                    @* Captured per iteration — the click lambdas outlive the loop. *@
                    var stage = visit.Stage;

                    <div class="flex flex-wrap items-center gap-2.5 border-b border-divider pb-2 text-[13px]">
                        <div class="flex-1">
                            <strong>Visit @stage</strong>
                            <div class="text-xs text-ink/55">
                                @visit.Reason
                                @if (visit.Minutes > 0)
                                {
                                    <text> · @visit.Minutes min</text>
                                }
                            </div>
                        </div>

                        @*
                            Three states, not two. A visit whose items were all delivered
                            has nothing to book and often no appointment left to open —
                            treating "not booked" as "needs booking" offered work already
                            in the patient's mouth as outstanding.
                        *@
                        @if (visit.NeedsBooking)
                        {
                            <button class="btn btn-secondary min-h-[44px] whitespace-nowrap"
                                    @onclick="() => Vm.BookVisitCommand.Execute(stage)">
                                Book visit @stage
                            </button>
                        }
                        else if (visit.IsDelivered)
                        {
                            <span class="tag tag-neutral whitespace-nowrap">Done</span>
                        }
                        else
                        {
                            <span class="tag tag-accent whitespace-nowrap">Booked</span>

                            @if (visit.AppointmentId is not null)
                            {
                                <button class="btn btn-ghost whitespace-nowrap text-xs"
                                        @onclick="() => Vm.OpenVisitCommand.Execute(stage)">
                                    Open →
                                </button>
                            }
                        }
                    </div>
                }
            </div>

            @if (Vm.BookingProgress is { Length: > 0 } progress)
            {
                <div class="mt-2 text-[11px] text-ink/55">@progress</div>
            }
        </div>

        <div class="text-[11px] text-ink/55">
            The consent is on the patient's record under Privacy &amp; data, with the
            figures as they were quoted.
        </div>
    }
    else if (Vm.IsDeclined)
    {
        <div class="border-2 border-divider p-3.5">
            <div class="font-heading text-lg font-extrabold">Declined</div>
            <div class="mt-1 text-xs text-ink/55">
                Kept on the record. Nothing stops a new plan being built later.
            </div>
        </div>
    }
    else if (Vm.IsAccepting)
    {
        <div class="border-2 border-neutral-900 p-3.5">
            <div class="field">
                <label class="label-field" for="signed-by">Name of the person accepting</label>
                <input id="signed-by" class="input min-h-[44px]"
                       placeholder="their full name"
                       @bind="Vm.SignedByName" @bind:event="oninput" />
            </div>

            <div class="field">
                <span class="label-field">Signing as</span>
                @*
                    Recorded rather than assumed. Consent for a child is given by a parent
                    or guardian, and a record that does not say who signed is not evidence
                    of anything in the one case where it matters most.
                *@
                <div class="seg">
                    @foreach (var relationship in PlanPresentationViewModel.Relationships)
                    {
                        <button type="button" class="@SegCss(Vm.IsRelationshipSelected(relationship))"
                                @onclick="() => Vm.SelectRelationshipCommand.Execute(relationship)">
                            @relationship
                        </button>
                    }
                </div>
            </div>

            @* A real drawn signature. This panel used to say capture was not built, which
               was true until the canvas existed and is the kind of line that quietly stops
               being true. *@
            <div class="field">
                <span class="label-field">Signature</span>
                <SignaturePadComponent Value="Vm.SignatureImage"
                                       ValueChanged="OnSignedAsync"
                                       Hint="Sign above with a finger or stylus." />
            </div>

            @if (Vm.SignatureImage is { Length: > 0 })
            {
                <button class="btn btn-ghost text-xs self-start"
                        @onclick="() => Vm.ClearSignature()">
                    Clear signature
                </button>
            }

            <div class="mt-1 text-[11px] text-ink/55">
                Signing records acceptance of this plan at the figures shown, witnessed by
                @Vm.ProviderName and timestamped.
            </div>
        </div>

        <button class="btn btn-primary min-h-[48px] w-full justify-start"
                disabled="@Vm.IsBusy"
                @onclick="() => Vm.ConfirmAcceptCommand.ExecuteAsync()">
            Record acceptance
        </button>

        <button class="btn btn-secondary w-full justify-start"
                @onclick="() => Vm.CancelAcceptCommand.Execute()">
            Back
        </button>
    }
    else if (Vm.IsDeclining)
    {
        <div class="border-2 border-divider p-3.5">
            <div class="field">
                <label class="label-field" for="decline-reason">Reason</label>
                <input id="decline-reason" class="input min-h-[44px]"
                       placeholder="e.g. cost · wants to think it over · seeking a second opinion"
                       @bind="Vm.DeclineReason" />
            </div>

            <div class="mt-1 text-[11px] text-ink/55">
                Kept with the plan's clinical reasoning. Why a patient said no is what the
                next conversation starts from.
            </div>
        </div>

        <button class="btn btn-primary min-h-[48px] w-full justify-start"
                disabled="@Vm.IsBusy"
                @onclick="() => Vm.ConfirmDeclineCommand.ExecuteAsync()">
            Record decline
        </button>

        <button class="btn btn-secondary w-full justify-start"
                @onclick="() => Vm.CancelDeclineCommand.Execute()">
            Back
        </button>
    }
    else
    {
        <button class="btn btn-primary min-h-[48px] w-full justify-start"
                @onclick="() => Vm.StartAcceptCommand.Execute()">
            Accept this plan
        </button>

        <button class="btn btn-secondary w-full justify-start"
                @onclick="() => Vm.StartDeclineCommand.Execute()">
            Not today — record a decline
        </button>

        <div class="text-[11px] text-ink/55">
            Nothing is recorded until one of these is confirmed, so the plan can be shown
            and talked through as many times as it takes.
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public PlanPresentationViewModel Vm { get; set; } = default!;

    private async Task OnSignedAsync(string? signature)
    {
        Vm.SignatureImage = signature;

        await Task.CompletedTask;
    }

    private static string SegCss(bool on) => on ? "seg-opt seg-opt-on" : "seg-opt";
}
