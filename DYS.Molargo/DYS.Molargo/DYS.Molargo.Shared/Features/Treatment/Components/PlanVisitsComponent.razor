@using DYS.Molargo.Shared.Features.Treatment.Services
@using DYS.Molargo.Shared.Features.Treatment.ViewModels

@*
    The builder's right column: the design's visit sequence, then the three figures the
    patient is actually quoted.

    Every visit is shown, including the empty ones, because the panel's job is to answer
    "how is this staged" — and a course that currently puts everything in visit 1 is
    something the clinician should see rather than have to infer from a missing card.
*@

<div class="flex flex-col gap-4 border-t-2 border-divider px-6 py-5 lg:border-t-0">
    <h5 class="m-0">Visit sequence</h5>

    @if (Vm.Draft is { } draft)
    {
        @foreach (var stage in Vm.Stages)
        {
            var items = draft.Stage(stage);
            var minutes = draft.StageMinutes(stage);

            <div class="border border-divider p-3">
                <div class="mb-1.5 flex items-baseline justify-between gap-2">
                    <strong class="font-heading text-sm">Visit @stage</strong>
                    <span class="text-xs text-ink/55">
                        @(minutes > 0 ? $"{minutes} min" : "—")
                    </span>
                </div>

                @if (items.Count == 0)
                {
                    <div class="py-1.5 text-xs text-ink/55">
                        No items — move one here with its visit chip.
                    </div>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <div class="flex justify-between gap-3 border-b border-divider py-1 text-[13px]">
                            <span>@item.PatientLabel</span>
                            <span class="whitespace-nowrap">@MolargoFormat.Money(item.Fee)</span>
                        </div>
                    }

                    <div class="flex justify-between gap-3 pt-1.5 text-[13px]">
                        <span class="text-ink/55">Subtotal</span>
                        <strong>@MolargoFormat.Money(draft.StageTotal(stage))</strong>
                    </div>
                }
            </div>
        }

        @* ---- the quote ---- *@
        <div class="border-t-2 border-divider pt-2.5 text-sm">
            <div class="flex justify-between gap-3 py-0.5">
                <span>Plan total</span>
                <strong>@MolargoFormat.Money(Vm.Total)</strong>
            </div>

            @if (Vm.HasBenefitEstimate)
            {
                <div class="flex justify-between gap-3 py-0.5">
                    <span>Fund estimate</span>
                    <strong>@MolargoFormat.Money(Vm.Benefit)</strong>
                </div>

                <div class="flex justify-between gap-3 py-0.5 text-accent-700">
                    <span>Patient out-of-pocket</span>
                    <strong>@MolargoFormat.Money(Vm.Gap)</strong>
                </div>
            }
            else
            {
                @*
                    No benefit estimated, so no gap is shown. Printing the full fee as the
                    out-of-pocket would state something nobody has checked — the patient's
                    fund may well cover a good part of it.
                *@
                <div class="flex justify-between gap-3 py-0.5 text-ink/55">
                    <span>Patient out-of-pocket</span>
                    <span>not estimated</span>
                </div>
            }
        </div>

        <div class="text-[11px] text-ink/55">
            Presenting freezes these figures against the plan. After that the quote is what
            the patient was shown and the builder will not rewrite it — a later change
            means a new plan, which is also how the alternatives get their own cards on the
            presentation screen.
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public PlanBuilderViewModel Vm { get; set; } = default!;
}
