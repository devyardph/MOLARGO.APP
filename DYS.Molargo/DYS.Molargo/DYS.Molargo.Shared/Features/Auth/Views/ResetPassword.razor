@page "/reset-password"
@layout EmptyLayout
@using DYS.Molargo.Shared.Features.Auth.ViewModels
@inherits MvvmComponentBase<ResetPasswordViewModel, string>

@*
    Setting a new password from an emailed link.

    The token arrives in the query string and is handed to the view model as its navigation
    parameter. Whose account it is gets shown before the boxes: somebody following a link
    out of an inbox should be able to see it is the right account before typing into it.

    The link is checked on load rather than on submit, so a dead one says so immediately
    instead of after somebody has chosen and confirmed a password.
*@

<PageTitle>Set a new password — Molargo</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-bg p-6">
    <div class="w-full max-w-[420px]">
        <div class="mb-6 font-heading text-[22px] font-extrabold">
            MOLARGO<span class="text-accent">.</span>
        </div>

        @if (!ViewModel.IsChecked)
        {
            <p class="text-sm text-ink/55">Checking that link…</p>
        }
        else if (!ViewModel.IsLinkGood)
        {
            <h4 class="mt-0 mb-1">That link no longer works</h4>

            @*
                One wording for expired, already used, and never real. Distinguishing them
                would confirm to a stranger that a token they guessed had once existed.
            *@
            <NoticeComponent Boxed="true" Kind="NoticeKind.Failure"
                             Headline="Expired or already used."
                             Message="Reset links work once and last thirty minutes. Ask for another one." />

            <div class="mt-5 flex flex-wrap gap-2">
                <a class="btn btn-primary" href="/forgot-password">Request another link</a>
                <a class="btn btn-secondary" href="/sign-in">Back to sign in</a>
            </div>
        }
        else if (ViewModel.IsDone)
        {
            <h4 class="mt-0 mb-1">Password changed</h4>

            <NoticeComponent Headline="Done."
                             Message="@($"Sign in as {ViewModel.Username} with the clinic code {ViewModel.ClinicCode}. Any lockout has been cleared.")" />

            <div class="mt-5">
                <a class="btn btn-primary btn-block min-h-[48px]" href="/sign-in">
                    Sign in →
                </a>
            </div>
        }
        else
        {
            <h4 class="mt-0 mb-1">Set a new password</h4>

            <p class="mt-0 mb-4 text-sm text-ink/70">
                For <strong>@ViewModel.StaffName</strong> (@ViewModel.Username) at
                @ViewModel.PracticeName.
            </p>

            @if (ViewModel.HasError)
            {
                <NoticeComponent Boxed="true" Spacing="mb-4" Kind="NoticeKind.Failure"
                                 Headline="@ViewModel.ErrorHeadline"
                                 Message="@ViewModel.ErrorMessage" />
            }

            <form class="flex flex-col gap-3.5" @onsubmit="Submit" @formname="reset">
                <div class="field">
                    <label for="reset-password">New password</label>
                    <input id="reset-password" class="input"
                           type="@(ViewModel.ShowPassword ? "text" : "password")"
                           autocomplete="new-password"
                           @bind="ViewModel.Password" @bind:event="oninput" />
                    <div class="mt-1 text-[11px] text-ink/55">
                        At least @ResetPasswordViewModel.MinimumLength characters.
                    </div>
                </div>

                <div class="field">
                    <label for="reset-confirm">Type it again</label>
                    <input id="reset-confirm" class="input"
                           type="@(ViewModel.ShowPassword ? "text" : "password")"
                           autocomplete="new-password"
                           @bind="ViewModel.Confirm" @bind:event="oninput" />
                    <FieldErrorComponent Message="@ViewModel.ConfirmError" />
                </div>

                @* Not a checkbox: this one belongs beside the fields it reveals, and the
                   shared check control is a row in a list. *@
                <button type="button" class="btn btn-ghost self-start text-xs"
                        @onclick="() => ViewModel.ToggleShowCommand.Execute()">
                    @(ViewModel.ShowPassword ? "Hide password" : "Show password")
                </button>

                <button type="submit" class="btn btn-primary btn-block min-h-[48px]"
                        disabled="@(!ViewModel.CanSave)">
                    @(ViewModel.IsBusy ? "Saving…" : "Set password")
                </button>
            </form>

            <p class="mt-5 mb-0 text-xs text-ink/55">
                This link stops working once you use it, and any other outstanding link for
                your account is cancelled at the same time.
            </p>
        }
    </div>
</div>

@code {
    /// <summary>
    /// The token, from the query string.
    /// </summary>
    /// <remarks>
    /// Supplied as the navigation parameter rather than read by the view model: a view model
    /// in this app knows nothing about Blazor, and NavigationManager is Blazor's.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override string NavigationParameter => Token ?? string.Empty;

    private Task Submit() =>
        ViewModel.CanSave ? ViewModel.SaveCommand.ExecuteAsync() : Task.CompletedTask;
}
