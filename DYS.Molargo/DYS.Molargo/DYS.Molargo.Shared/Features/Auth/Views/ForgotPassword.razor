@page "/forgot-password"
@layout EmptyLayout
@using DYS.Molargo.Shared.Features.Auth.ViewModels
@inherits MvvmComponentBase<ForgotPasswordViewModel>

@*
    Resetting a password with an emailed code, for somebody who cannot sign in.

    A code rather than a link, and it is the code that makes this work at all. This app has
    no server — every head keeps its own SQLite file — so anything issued on a tablet exists
    only in that tablet's database. A link invites the recipient to open it wherever their
    mail is, which is somewhere else, where it cannot be honoured. A code brings them back
    here. Same behaviour on iOS, Android, Windows and the web, with no deep linking.

    Same empty layout as sign-in: the shell's navigation would let an unauthenticated
    visitor click into a patient list.
*@

<PageTitle>Forgot password — Molargo</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-bg p-6">
    <div class="w-full max-w-[420px]">
        <div class="mb-6 font-heading text-[22px] font-extrabold">
            MOLARGO<span class="text-accent">.</span>
        </div>

        @if (ViewModel.IsDone)
        {
            <h4 class="mt-0 mb-1">Password changed</h4>

            <NoticeComponent Headline="Done."
                             Message="Any lockout has been cleared. Sign in with your new password." />

            <div class="mt-5">
                <a class="btn btn-primary btn-block min-h-[48px]" href="/sign-in">
                    Sign in →
                </a>
            </div>
        }
        else
        {
            <h4 class="mt-0 mb-1">Forgot your password</h4>

            <p class="mt-0 mb-4 text-sm text-ink/70">
                @if (!ViewModel.IsEnteringCode)
                {
                    <span>
                        We will email a six-digit code to the address on your staff record.
                        Come back here and type it in — it expires in ten minutes.
                    </span>
                }
                else
                {
                    @*
                        "If that account exists" rather than "we have sent". The screen
                        genuinely does not know, and a confident claim would be a lie half
                        the times it is shown.
                    *@
                    <span>
                        If that account exists and has an email address on file, a code is
                        on its way. Type it in below with your new password.
                    </span>
                }
            </p>

            @if (ViewModel.HasError)
            {
                <NoticeComponent Boxed="true" Spacing="mb-4" Kind="NoticeKind.Failure"
                                 Headline="@ViewModel.ErrorHeadline"
                                 Message="@ViewModel.ErrorMessage" />
            }

            <form class="flex flex-col gap-3.5" @onsubmit="Submit" @formname="forgot">
                @*
                    Both steps keep these two. The second needs them to find the account the
                    code belongs to — a six-digit code is only ever checked against an
                    account somebody has already named, which is most of what makes six
                    digits safe enough.
                *@
                <div class="field">
                    <label for="forgot-tenant">Clinic code</label>
                    <input id="forgot-tenant" class="input" autocomplete="organization"
                           placeholder="e.g. molargo-dental"
                           @bind="ViewModel.ClinicCode" @bind:event="oninput" />
                </div>

                <div class="field">
                    <label for="forgot-username">Username</label>
                    <input id="forgot-username" class="input" autocomplete="username"
                           @bind="ViewModel.Username" @bind:event="oninput" />
                </div>

                @if (!ViewModel.IsEnteringCode)
                {
                    <button type="submit" class="btn btn-primary btn-block min-h-[48px]"
                            disabled="@(!ViewModel.CanRequest)">
                        @(ViewModel.IsBusy ? "Sending…" : "Email me a code")
                    </button>

                    @* For somebody who closed the app and came back with the code in hand. *@
                    <button type="button" class="btn btn-ghost self-start text-xs"
                            @onclick="() => ViewModel.HaveCodeCommand.Execute()">
                        I already have a code
                    </button>
                }
                else
                {
                    <div class="field">
                        <label for="forgot-code">Six-digit code</label>
                        @*
                            inputmode numeric brings up the number pad on a tablet, which is
                            where this gets typed most often. Still a text box, because the
                            value is a string — "004821" keeps its leading zeros.
                        *@
                        <input id="forgot-code" class="input font-mono tracking-[0.3em]"
                               inputmode="numeric" maxlength="6" autocomplete="one-time-code"
                               placeholder="000000"
                               @bind="ViewModel.Code" @bind:event="oninput" />
                    </div>

                    <div class="field">
                        <label for="forgot-password">New password</label>
                        <input id="forgot-password" class="input"
                               type="@(ViewModel.ShowPassword ? "text" : "password")"
                               autocomplete="new-password"
                               @bind="ViewModel.Password" @bind:event="oninput" />
                        <div class="mt-1 text-[11px] text-ink/55">
                            At least @ForgotPasswordViewModel.MinimumLength characters.
                        </div>
                    </div>

                    <div class="field">
                        <label for="forgot-confirm">Type it again</label>
                        <input id="forgot-confirm" class="input"
                               type="@(ViewModel.ShowPassword ? "text" : "password")"
                               autocomplete="new-password"
                               @bind="ViewModel.Confirm" @bind:event="oninput" />
                        <FieldErrorComponent Message="@ViewModel.ConfirmError" />
                    </div>

                    <button type="button" class="btn btn-ghost self-start text-xs"
                            @onclick="() => ViewModel.ToggleShowCommand.Execute()">
                        @(ViewModel.ShowPassword ? "Hide password" : "Show password")
                    </button>

                    <button type="submit" class="btn btn-primary btn-block min-h-[48px]"
                            disabled="@(!ViewModel.CanReset)">
                        @(ViewModel.IsBusy ? "Checking…" : "Reset password")
                    </button>

                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="btn btn-secondary text-xs"
                                disabled="@(!ViewModel.CanRequest)"
                                @onclick="() => ViewModel.RequestCommand.ExecuteAsync()">
                            Send another code
                        </button>

                        <button type="button" class="btn btn-ghost text-xs"
                                @onclick="() => ViewModel.BackCommand.Execute()">
                            Start again
                        </button>
                    </div>
                }
            </form>

            <p class="mt-5 mb-0 text-xs text-ink/55">
                No code arriving? The practice may have no mail account set up under
                Admin → Settings, or your staff record may have no email address — in either
                case somebody with staff access has to set your password for you. A practice
                owner can only be reset by another owner.
            </p>

            <p class="mt-3 mb-0 text-xs text-ink/55">
                <a class="text-accent" href="/sign-in">Back to sign in</a>
            </p>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Enter does whichever step is showing.
    /// </summary>
    /// <remarks>
    /// One form across both steps, so the submit handler has to choose. Two forms would have
    /// meant the clinic code and username living in one of them and being read by the other.
    /// </remarks>
    private Task Submit()
    {
        if (!ViewModel.IsEnteringCode)
        {
            return ViewModel.CanRequest
                ? ViewModel.RequestCommand.ExecuteAsync()
                : Task.CompletedTask;
        }

        return ViewModel.CanReset
            ? ViewModel.ResetCommand.ExecuteAsync()
            : Task.CompletedTask;
    }
}
