@page "/forgot-password"
@layout EmptyLayout
@using DYS.Molargo.Shared.Features.Auth.ViewModels
@inherits MvvmComponentBase<ForgotPasswordViewModel>
@inject IAppLinks Links

@*
    Asking for a reset link, for somebody who cannot sign in.

    Its own page rather than a panel on the sign-in form, because it is reachable from an
    email's "request another one" and has to survive a reload. Same empty layout as sign-in:
    the shell's navigation would let an unauthenticated visitor click into a patient list.

    One outcome, whatever happened. The screen cannot say "no such username" without
    handing a stranger a way to map the practice's staff list one guess at a time — and the
    clinic code is derived from the practice name, so it is not a secret that gates this.
*@

<PageTitle>Forgot password — Molargo</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-bg p-6">
    <div class="w-full max-w-[420px]">
        <div class="mb-6 font-heading text-[22px] font-extrabold">
            MOLARGO<span class="text-accent">.</span>
        </div>

        @*
            Reachable by URL whatever head this is, so the capability is checked here and
            not only on the link that leads here. A device install has no shared store for
            a token to be found in, so the form is replaced rather than shown and refused.
        *@
        @if (!Links.SupportsEmailedLinks)
        {
            <h4 class="mt-0 mb-1">Not available on this device</h4>

            <NoticeComponent Boxed="true" Kind="NoticeKind.Failure"
                             Headline="No emailed reset here."
                             Message="This install keeps its own records, so a link emailed from it could only be opened on this device. Ask somebody with staff access to set your password under Admin → Users — an owner can only be reset by another owner." />

            <div class="mt-5">
                <a class="btn btn-primary" href="/sign-in">Back to sign in</a>
            </div>
        }
        else if (!ViewModel.IsSent)
        {
            <h4 class="mt-0 mb-1">Forgot your password</h4>

            <p class="mt-0 mb-4 text-sm text-ink/70">
                We will email a link to the address on your staff record. It works once and
                expires in thirty minutes.
            </p>

            @if (ViewModel.HasError)
            {
                <NoticeComponent Boxed="true" Spacing="mb-4" Kind="NoticeKind.Failure"
                                 Headline="@ViewModel.ErrorHeadline"
                                 Message="@ViewModel.ErrorMessage" />
            }

            <form class="flex flex-col gap-3.5" @onsubmit="Submit" @formname="forgot">
                <div class="field">
                    <label for="forgot-tenant">Clinic code</label>
                    <input id="forgot-tenant" class="input" autocomplete="organization"
                           placeholder="e.g. molargo-dental"
                           @bind="ViewModel.ClinicCode" @bind:event="oninput" />
                </div>

                <div class="field">
                    <label for="forgot-username">Username</label>
                    <input id="forgot-username" class="input" autocomplete="username"
                           @bind="ViewModel.Username" @bind:event="oninput" />
                </div>

                <button type="submit" class="btn btn-primary btn-block min-h-[48px]"
                        disabled="@(!ViewModel.CanSubmit)">
                    @(ViewModel.IsBusy ? "Sending…" : "Email me a link")
                </button>
            </form>
        }
        else
        {
            <h4 class="mt-0 mb-1">Check your email</h4>

            @*
                Carefully worded. "If that account exists" rather than "we have sent" —
                because the screen genuinely does not know, and a confident claim would be
                a lie half the time it is shown.
            *@
            <NoticeComponent Headline="Request taken."
                             Message="If that account exists and has an email address on file, a link is on its way. It works once and expires in thirty minutes." />

            <p class="mt-4 mb-0 text-xs text-ink/55">
                Nothing arrived? The practice may have no mail account set up under
                Admin → Settings, or your staff record may have no email address — in
                either case somebody who can manage staff has to set your password for you.
                A practice owner can only be reset by another owner.
            </p>

            <div class="mt-5 flex flex-wrap gap-2">
                <a class="btn btn-primary" href="/sign-in">Back to sign in</a>

                <button class="btn btn-secondary"
                        @onclick="() => ViewModel.AgainCommand.Execute()">
                    Try another username
                </button>
            </div>
        }

        @if (Links.SupportsEmailedLinks && !ViewModel.IsSent)
        {
            @* Only under the form. Both of the other two branches carry their own
               way back, and a second one under them read as a stray link. *@
            <p class="mt-5 mb-0 text-xs text-ink/55">
                <a class="text-accent" href="/sign-in">Back to sign in</a>
            </p>
        }
    </div>
</div>

@code {
    private Task Submit() =>
        ViewModel.CanSubmit ? ViewModel.RequestCommand.ExecuteAsync() : Task.CompletedTask;
}
