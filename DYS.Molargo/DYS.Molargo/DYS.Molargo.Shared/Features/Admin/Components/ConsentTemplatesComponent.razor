@using DYS.Molargo.Shared.Features.Admin.ViewModels

@*
    The practice's consent wording: the list on the left, the editor on the right — the
    same shape as the message templates in Comms, because it is the same job.

    It sits in Admin rather than beside those, though. Comms templates are messages sent to
    patients, with merge fields and a channel; a consent template is a clinical-legal
    document the patient reads and signs. Grouping them by "both are templates" would put
    the wording that has to satisfy an indemnity insurer next to the wording for a birthday
    SMS.
*@

<div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr]">
    <div class="border-divider px-6 py-5 lg:border-r-2">
        <div class="mb-3 flex flex-wrap items-center gap-2.5">
            <h5 class="m-0 flex-1">Consent templates</h5>

            <button class="btn btn-secondary whitespace-nowrap"
                    @onclick="() => Vm.NewConsentTemplateCommand.Execute()">
                New template
            </button>
        </div>

        @if (Vm.ConsentTemplates.Count == 0)
        {
            <p class="text-sm text-ink/55">
                No wording set up. Until there is, consent forms are raised with the
                built-in standard wording — which is standard, not your insurer's.
            </p>
        }
        else
        {
            <div class="flex flex-col gap-2">
                @foreach (var row in Vm.ConsentTemplates)
                {
                    @* Captured per iteration — the click lambda outlives the loop. *@
                    var template = row;

                    <button type="button"
                            class="@RowCss(Vm.EditingConsentTemplate?.Id == template.TemplateId)"
                            @onclick="() => Vm.SelectConsentTemplateCommand.ExecuteAsync(template.TemplateId)">
                        <span class="flex-1 text-[13px] font-bold">@template.Name</span>

                        @if (template.InUse > 0)
                        {
                            @* Signed consents behind this wording. Shown in the list so the
                               weight of an edit is visible before it is opened. *@
                            <span class="tag tag-neutral whitespace-nowrap">
                                @template.InUse signed
                            </span>
                        }

                        @if (!template.IsActive)
                        {
                            <span class="tag tag-outline whitespace-nowrap">Retired</span>
                        }
                        else if (template.Category is { Length: > 0 } category)
                        {
                            <span class="tag tag-accent whitespace-nowrap">@category</span>
                        }
                        else
                        {
                            <span class="tag tag-neutral whitespace-nowrap">By hand</span>
                        }
                    </button>
                }
            </div>
        }

        <p class="mt-3 mb-0 text-xs text-ink/55">
            Wording is <strong>copied onto a consent</strong> when it is raised. Editing a
            template never changes a form somebody has already signed — what they agreed to
            is the text that was in front of them that day.
        </p>
    </div>

    @if (Vm.EditingConsentTemplate is { } editing)
    {
        <div class="flex flex-col gap-3 px-6 py-5">
            <div class="flex flex-wrap items-baseline gap-2.5">
                <h5 class="m-0">
                    @(Vm.IsNewConsentTemplate ? "New consent template" : editing.Name)
                </h5>

                @if (!Vm.ConsentTemplateIsActive && !Vm.IsNewConsentTemplate)
                {
                    <span class="tag tag-outline">Retired</span>
                }
            </div>

            <div class="field max-w-[420px]">
                <label class="label-field" for="consent-template-name">Template name</label>
                <input id="consent-template-name" class="input"
                       placeholder="e.g. Surgical extraction"
                       @bind="Vm.ConsentTemplateName" @bind:event="oninput" />
            </div>

            <div class="field">
                <span class="label-field">Applies to</span>

                @*
                    The schedule's own categories, read from the fee catalogue rather than
                    listed here — a practice that adds a category to its schedule finds it
                    offered on this screen without anybody editing the app.
                *@
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var name in Vm.ProcedureCategories)
                    {
                        var category = name;

                        <button type="button" class="@CategoryCss(Vm.IsConsentTemplateCategory(category))"
                                @onclick="() => Vm.SetConsentTemplateCategoryCommand.Execute(category)">
                            @category
                        </button>
                    }
                </div>

                <p class="mt-1.5 mb-0 text-xs text-ink/55">
                    @Vm.ConsentTemplateCategoryNote Click it again to detach it.
                </p>
            </div>

            <div class="field">
                <label class="label-field" for="consent-template-body">
                    Risks, alternatives and costs as the patient reads them
                </label>
                <textarea id="consent-template-body" class="input min-h-[160px] text-[13px]"
                          placeholder="Risks discussed: … Alternatives and costs presented. Questions answered."
                          @bind="Vm.ConsentTemplateBody" @bind:event="oninput"></textarea>
            </div>

            <div class="flex flex-wrap gap-2">
                <button class="btn btn-primary whitespace-nowrap"
                        disabled="@Vm.IsBusy"
                        @onclick="() => Vm.SaveConsentTemplateCommand.ExecuteAsync()">
                    Save wording
                </button>

                @if (!Vm.IsNewConsentTemplate)
                {
                    @*
                        Retired, never deleted. A consent signed last year was signed against
                        wording, and a record of what somebody agreed to that no longer has
                        the words in it is not a record of anything.
                    *@
                    @if (Vm.ConsentTemplateIsActive)
                    {
                        <button class="btn btn-secondary whitespace-nowrap"
                                disabled="@Vm.IsBusy"
                                @onclick="() => Vm.RetireConsentTemplateCommand.ExecuteAsync()">
                            Retire it
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary whitespace-nowrap"
                                disabled="@Vm.IsBusy"
                                @onclick="() => Vm.RestoreConsentTemplateCommand.ExecuteAsync()">
                            Put it back in use
                        </button>
                    }
                }

                <button class="btn btn-ghost whitespace-nowrap"
                        @onclick="() => Vm.CancelConsentTemplateCommand.Execute()">
                    Cancel
                </button>
            </div>

            <p class="mt-1 mb-0 text-xs text-ink/55">
                No merge fields here, unlike a message template. A consent is read and signed
                in one sitting, and a token that failed to fill would reach the patient as
                literal braces on the document they are signing.
            </p>
        </div>
    }
    else
    {
        <div class="px-6 py-5">
            <p class="text-sm text-ink/55">Choose a template to edit it, or add one.</p>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public AdminViewModel Vm { get; set; } = default!;

    /// <remarks>
    /// Whole literal strings, both branches — Tailwind scans source text, so a class
    /// assembled from a base plus a conditional suffix never reaches the stylesheet.
    /// </remarks>
    private static string RowCss(bool on) =>
        on
            ? "flex w-full cursor-pointer items-center gap-2.5 border border-accent bg-accent-100 px-3 py-2 text-left font-[inherit]"
            : "flex w-full cursor-pointer items-center gap-2.5 border border-divider bg-transparent px-3 py-2 text-left font-[inherit] hover:border-ink/35";

    private static string CategoryCss(bool on) =>
        on ? "tag tag-accent cursor-pointer" : "tag tag-outline cursor-pointer";
}
