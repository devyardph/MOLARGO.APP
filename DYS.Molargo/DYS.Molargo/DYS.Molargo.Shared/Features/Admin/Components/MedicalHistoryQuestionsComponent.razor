@using DYS.Molargo.Domain.Entities
@using DYS.Molargo.Domain.Enums
@using DYS.Molargo.Shared.Features.Admin.ViewModels

@*
    The practice's medical-history questionnaire: the form on the left in the order a
    patient answers it, the editor on the right.

    This set used to live in code, on the reasoning that every change needs a version bump
    and a clinician's sign-off. The risk was real; the remedy was not. A bump a developer
    has to remember is a bump that gets missed, so it is arithmetic now — any edit that
    changes what a patient sees raises the version, and every completed form keeps the
    version it answered.
*@

<div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr]">
    <div class="border-divider px-6 py-5 lg:border-r-2">
        <div class="mb-1 flex flex-wrap items-center gap-2.5">
            <h5 class="m-0 flex-1">Questionnaire</h5>

            <button class="btn btn-secondary whitespace-nowrap"
                    @onclick="() => Vm.NewQuestionCommand.Execute()">
                Add a question
            </button>
        </div>

        <p class="mt-0 mb-3 text-xs text-ink/55">
            Form version <strong>@Vm.QuestionSetVersion</strong> — stamped on every
            questionnaire completed from now on.
        </p>

        <div class="flex flex-col gap-2">
            @foreach (var row in Vm.Questions)
            {
                @* Captured per iteration — the click lambdas outlive the loop. *@
                var question = row;

                <div class="@RowCss(Vm.EditingQuestion?.Id == question.Id)">
                    <button type="button"
                            class="min-w-0 flex-1 cursor-pointer border-0 bg-transparent p-0 text-left font-[inherit]"
                            @onclick="() => Vm.SelectQuestionCommand.ExecuteAsync(question.Id)">
                        <div class="text-[13px] font-bold">@question.Text</div>
                        <div class="mt-0.5 flex flex-wrap items-center gap-1.5">
                            <span class="font-mono text-[10px] text-neutral-600">
                                @question.Code
                            </span>

                            @if (question.AlertKind is { } kind)
                            {
                                <span class="@SeverityCss(question.Severity)">
                                    @AdminViewModel.AlertKindLabel(kind)
                                </span>
                            }
                            else
                            {
                                <span class="tag tag-neutral">No alert</span>
                            }

                            @if (!question.IsActive)
                            {
                                <span class="tag tag-outline">Retired</span>
                            }
                        </div>
                    </button>

                    @if (question.IsActive)
                    {
                        @*
                            Order is the design's point: the things that stop treatment come
                            first, so a patient who abandons the form half-way has still
                            answered what matters most. Moving one is not a change of
                            meaning, so it does not move the version.
                        *@
                        <div class="flex shrink-0 flex-col">
                            <button class="btn btn-ghost px-1.5 py-0 text-xs"
                                    aria-label="@($"Move \"{question.Text}\" earlier")"
                                    @onclick="() => Vm.MoveQuestionUpCommand.ExecuteAsync(question.Id)">
                                ↑
                            </button>
                            <button class="btn btn-ghost px-1.5 py-0 text-xs"
                                    aria-label="@($"Move \"{question.Text}\" later")"
                                    @onclick="() => Vm.MoveQuestionDownCommand.ExecuteAsync(question.Id)">
                                ↓
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <p class="mt-3 mb-0 text-xs text-ink/55">
            Questions are <strong>retired, never deleted</strong>. Answers already given
            keep both the wording the patient read and the version they answered, so an old
            record stays interpretable after the form moves on.
        </p>
    </div>

    @if (Vm.EditingQuestion is { } editing)
    {
        <div class="flex flex-col gap-3 px-6 py-5">
            <div class="flex flex-wrap items-baseline gap-2.5">
                <h5 class="m-0">@(Vm.IsNewQuestion ? "New question" : "Edit question")</h5>

                @if (!Vm.QuestionIsActive && !Vm.IsNewQuestion)
                {
                    <span class="tag tag-outline">Retired</span>
                }
            </div>

            <div class="field max-w-[260px]">
                <label class="label-field" for="question-code">Code</label>

                @if (Vm.CanEditQuestionCode)
                {
                    <input id="question-code" class="input font-mono text-[13px]"
                           placeholder="e.g. bisphosphonates"
                           @bind="Vm.QuestionCode" @bind:event="oninput" />
                    <p class="mt-1 mb-0 text-xs text-ink/55">
                        Short, lowercase, and permanent. Every answer is stored against it.
                    </p>
                }
                else
                {
                    @*
                        Shown, not editable. The code is the join to every answer already
                        given; changing it would orphan them and silently empty the reports
                        that match on it.
                    *@
                    <div class="font-mono text-[13px]">@editing.Code</div>
                    <p class="mt-1 mb-0 text-xs text-ink/55">
                        Fixed once the question exists. To change it, retire this one and
                        add a new question.
                    </p>
                }
            </div>

            <div class="field">
                <label class="label-field" for="question-text">
                    The question as the patient reads it
                </label>
                <input id="question-text" class="input"
                       placeholder="e.g. Have you ever taken bisphosphonates?"
                       @bind="Vm.QuestionText" @bind:event="oninput" />
            </div>

            <div class="field">
                <span class="label-field">A "yes" raises</span>

                <div class="flex flex-wrap gap-1.5">
                    @foreach (var option in AdminViewModel.QuestionAlertKinds)
                    {
                        var kind = option;

                        <button type="button" class="@ChipCss(Vm.IsQuestionAlertKind(kind))"
                                @onclick="() => Vm.SetQuestionAlertKindCommand.Execute(kind.ToString())">
                            @AdminViewModel.AlertKindLabel(kind)
                        </button>
                    }

                    <button type="button" class="@ChipCss(Vm.QuestionRaisesNoAlert)"
                            @onclick="() => Vm.SetQuestionAlertKindCommand.Execute(string.Empty)">
                        No alert
                    </button>
                </div>

                <p class="mt-1.5 mb-0 text-xs text-ink/55">@Vm.QuestionAlertNote</p>
            </div>

            @if (!Vm.QuestionRaisesNoAlert)
            {
                <div class="field">
                    <span class="label-field">At severity</span>

                    <div class="seg">
                        @foreach (var option in AdminViewModel.QuestionSeverities)
                        {
                            var severity = option;

                            <button type="button" class="@SegCss(Vm.IsQuestionSeverity(severity))"
                                    @onclick="() => Vm.SetQuestionSeverityCommand.Execute(severity)">
                                @severity
                            </button>
                        }
                    </div>

                    <p class="mt-1.5 mb-0 text-xs text-ink/55">
                        Critical stops treatment and sits at the top of the banner. Marking
                        everything critical is the same as marking nothing.
                    </p>
                </div>
            }

            <div class="field">
                <span class="label-field">Ask for details</span>

                <div class="seg">
                    <button type="button" class="@SegCss(Vm.QuestionPromptsForDetail)"
                            @onclick="() => Vm.ToggleQuestionDetailCommand.Execute()">
                        Yes
                    </button>
                    <button type="button" class="@SegCss(!Vm.QuestionPromptsForDetail)"
                            @onclick="() => Vm.ToggleQuestionDetailCommand.Execute()">
                        No
                    </button>
                </div>

                <p class="mt-1.5 mb-0 text-xs text-ink/55">
                    A bare "yes" to allergies tells a prescriber nothing. The listed items
                    become the alerts on the record.
                </p>
            </div>

            @if (Vm.QuestionPromptsForDetail)
            {
                <div class="field">
                    <label class="label-field" for="question-detail">
                        The label on the detail box
                    </label>
                    <input id="question-detail" class="input"
                           placeholder="If yes, please give details"
                           @bind="Vm.QuestionDetailPrompt" @bind:event="oninput" />
                </div>
            }

            <div class="flex flex-wrap gap-2">
                <button class="btn btn-primary whitespace-nowrap"
                        disabled="@Vm.IsBusy"
                        @onclick="() => Vm.SaveQuestionCommand.ExecuteAsync()">
                    Save question
                </button>

                @if (!Vm.IsNewQuestion)
                {
                    @if (Vm.QuestionIsActive)
                    {
                        <button class="btn btn-secondary whitespace-nowrap"
                                disabled="@Vm.IsBusy"
                                @onclick="() => Vm.RetireQuestionCommand.ExecuteAsync()">
                            Retire it
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary whitespace-nowrap"
                                disabled="@Vm.IsBusy"
                                @onclick="() => Vm.RestoreQuestionCommand.ExecuteAsync()">
                            Put it back on the form
                        </button>
                    }
                }

                <button class="btn btn-ghost whitespace-nowrap"
                        @onclick="() => Vm.CancelQuestionCommand.Execute()">
                    Cancel
                </button>
            </div>

            <p class="mt-1 mb-0 text-xs text-ink/55">
                Rewording a question, changing what a "yes" raises, or retiring one moves
                the form to a new version. Reordering does not — where a question sits is
                not what it means.
            </p>
        </div>
    }
    else
    {
        <div class="px-6 py-5">
            <p class="text-sm text-ink/55">Choose a question to edit it, or add one.</p>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public AdminViewModel Vm { get; set; } = default!;

    /// <remarks>
    /// Whole literal strings — Tailwind scans source text, so a class assembled from a
    /// base plus a conditional suffix never reaches the stylesheet.
    /// </remarks>
    private static string RowCss(bool on) =>
        on
            ? "flex items-start gap-2 border border-accent bg-accent-100 px-3 py-2"
            : "flex items-start gap-2 border border-divider px-3 py-2 hover:border-ink/35";

    private static string ChipCss(bool on) =>
        on ? "tag tag-accent cursor-pointer" : "tag tag-outline cursor-pointer";

    private static string SegCss(bool on) => on ? "seg-opt seg-opt-on" : "seg-opt";

    private static string SeverityCss(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Critical => "tag tag-accent2",
        AlertSeverity.Warning => "tag tag-warn",
        _ => "tag tag-neutral",
    };
}
