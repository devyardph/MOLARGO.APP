@using DYS.Molargo.Shared.Features.Admin.Services
@using DYS.Molargo.Shared.Features.Admin.ViewModels

@*
    The design's audit log.

    The entries here are real and are written by this screen's own actions — the design's
    "all actions below are themselves audit-logged" is true of the admin panes. It is true
    of nothing else in the app, which is the whole point of the notice below the table.

    Deliberately not seeded. An audit trail with invented history is worse than an empty
    one: the empty one tells you nothing was recorded, and the seeded one tells you
    something happened that did not.
*@

<div class="max-w-[1100px] px-6 py-5">
    <div class="mb-3 flex flex-wrap items-center gap-2.5">
        <h5 class="m-0 flex-1">Audit log</h5>

        @foreach (var filter in AdminViewModel.AuditFilters)
        {
            <button type="button" class="@ChipCss.Chip(Vm.AuditFilter == filter)"
                    @onclick="() => Vm.SetAuditFilterCommand.ExecuteAsync(filter?.ToString() ?? string.Empty)">
                @AdminViewModel.FilterLabel(filter)
            </button>
        }
    </div>

    @if (Vm.Audit.Count == 0)
    {
        <div class="border-2 border-divider bg-surface p-3.5 text-sm">
            <strong>Nothing recorded yet.</strong>
            <div class="mt-1 text-xs text-ink/70">
                @if (Vm.AuditFilter is not null)
                {
                    <text>
                        No entries of this kind. Try <strong>Everything</strong>.
                    </text>
                }
                else
                {
                    @*
                        The honest reason, rather than an empty table that looks broken.
                    *@
                    <text>
                        The log is empty because almost nothing in Molargo writes to it
                        yet. Deactivate a staff member, change a registration or take a
                        backup, and the entry appears here — those actions are audited.
                    </text>
                }
            </div>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr>
                        <th class="head-cell">When</th>
                        <th class="head-cell">Who</th>
                        <th class="head-cell">Action</th>
                        <th class="head-cell">Record</th>
                        <th class="head-cell">Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Vm.Audit)
                    {
                        <tr>
                            <td class="body-cell text-xs">
                                @MolargoFormat.DayTime(row.OccurredUtc)
                            </td>
                            <td class="body-cell">
                                <strong>@(row.ProviderName ?? "unknown")</strong>

                                @if (row.DeviceId is { Length: > 0 } device)
                                {
                                    @* Which installation, which is what an offline-first
                                       practice can actually trace a change to. *@
                                    <div class="font-mono text-[11px] text-ink/55">
                                        @Shorten(device)
                                    </div>
                                }
                            </td>
                            <td class="body-cell">
                                <span class="@AdminCss.ActionTag(row.Action)">
                                    @AdminService.ActionLabel(row.Action)
                                </span>
                            </td>
                            <td class="body-cell text-xs">
                                @row.EntityName

                                @if (row.PatientName is { Length: > 0 } patient)
                                {
                                    <div class="text-ink/55">@patient</div>
                                }
                            </td>
                            <td class="body-cell text-xs">@(row.Detail ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-4 border-2 border-accent bg-accent-100 p-3 text-sm text-accent-800"
         role="note">
        <strong>The rest of the app is not audited.</strong>
        <div class="mt-1 text-xs">
            Only the admin actions on this screen write entries. Opening a patient record,
            signing a clinical note, issuing an invoice, releasing a sterilisation load —
            none of it is logged. A privacy complaint asking "who looked at this patient"
            cannot be answered from here.
        </div>
    </div>

    <p class="mt-3 mb-0 text-xs text-ink/55">
        @*
            The design's four claims about this log, checked one at a time. Each is a
            specific promise a practice would rely on in an investigation.
        *@
        The design promises every view and change is recorded, immutable, hash-chained and
        retained seven years. What holds: entries are append-only in practice and stamp who
        acted, when, and on which installation. What does not:
        <strong>views are not recorded</strong> at all,
        <strong>nothing is hash-chained</strong> — an entry could be altered in the
        database file with no trace — and there is
        <strong>no retention policy</strong>, so entries simply accumulate.
        Searching by patient and user needs access logging first, or there is nothing to
        search.
    </p>
</div>

@code {
    [Parameter, EditorRequired] public AdminViewModel Vm { get; set; } = default!;

    /// <summary>
    /// The first block of an installation id.
    /// </summary>
    /// <remarks>
    /// A full GUID beside every row crowds out the detail column, and the leading block is
    /// enough to tell two tablets apart — which is the question the column answers.
    /// </remarks>
    private static string Shorten(string deviceId) =>
        deviceId.Length <= 8 ? deviceId : deviceId[..8];
}
