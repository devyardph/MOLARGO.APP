@page "/platform/sms"
@using DYS.Molargo.Shared.Features.Platform.Services
@using DYS.Molargo.Shared.Features.Platform.ViewModels
@inherits MvvmComponentBase<SmsGatewaysViewModel>

@*
    The vendor's SMS providers, one per country.

    A vendor screen rather than a clinic one, unlike the mail account under Admin → Settings.
    A practice sets up its own mail because the messages go out under its address and it pays
    for them; SMS needs a sender id registered with a carrier country by country, which no
    single clinic is going to do. So the vendor holds one gateway per country and every
    practice in that country sends through it.

    The list-then-editor split the rest of the app uses.
*@

<PageTitle>SMS gateways — Molargo</PageTitle>

<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b-2 border-divider px-6 py-4">
    <h4 class="m-0">SMS gateways</h4>

    <div class="text-[13px] text-ink/55">
        Signed in as @ViewModel.ActingAs · vendor account
    </div>
</div>

@if (ViewModel.HasError)
{
    <NoticeComponent Kind="NoticeKind.Failure"
                     Headline="@ViewModel.ErrorHeadline"
                     Message="@ViewModel.ErrorMessage" />
}
else if (ViewModel.LastAction is { Length: > 0 } action)
{
    <NoticeComponent Message="@action" />
}

@if (!ViewModel.IsPermitted)
{
    <div class="px-6 py-5">
        <p class="m-0 text-sm text-ink/55">
            This screen belongs to the vendor. A practice's own message settings are under
            Admin → Settings.
        </p>
    </div>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr]">
        <div class="border-divider px-6 py-5 lg:border-r-2">
            <div class="mb-3 flex flex-wrap items-center gap-2.5">
                <h5 class="m-0 flex-1">By country</h5>

                <button class="btn btn-secondary whitespace-nowrap"
                        @onclick="() => ViewModel.NewGatewayCommand.Execute()">
                    New country
                </button>
            </div>

            @if (ViewModel.Gateways.Count == 0)
            {
                <p class="text-sm text-ink/55">
                    No countries configured, so no practice anywhere can send a text. Add
                    the provider for each country you sell in.
                </p>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var row in ViewModel.Gateways)
                    {
                        @* Captured per iteration — the click lambda outlives the loop. *@
                        var gateway = row;

                        <button type="button"
                                class="@RowCss(ViewModel.IsEditing && ViewModel.Country == gateway.CountryCode)"
                                @onclick="() => ViewModel.EditGatewayCommand.Execute(gateway.GatewayId)">
                            <span class="flex-1 text-[13px] font-bold">
                                @gateway.CountryCode

                                <span class="block text-[11px] font-normal text-ink/55">
                                    @*
                                        The rate at four places with the code beside it,
                                        not a currency-formatted amount. A per-message rate
                                        is fractions of a cent, and MoneyIn rounds to the
                                        currency — a stored 0.045 rendered as ₱0.05, which
                                        is a different price from the one that was typed.
                                    *@
                                    @gateway.ProviderName ·
                                    @gateway.PricePerMessage.ToString("0.####")
                                    @gateway.CurrencyCode per message
                                </span>
                            </span>

                            @if (!gateway.IsActive)
                            {
                                <span class="tag tag-outline whitespace-nowrap">Off</span>
                            }
                            else if (!gateway.IsAuthComplete)
                            {
                                @* Configured but unusable. Called out rather than shown as
                                   on, because "active with no credential" sends nothing and
                                   the list is where somebody would otherwise read it as
                                   fine. Named per scheme — a Basic row is short a username,
                                   not a key, and may legitimately have no password. *@
                                <span class="tag tag-accent2 whitespace-nowrap">
                                    @gateway.MissingLabel
                                </span>
                            }
                            else
                            {
                                <span class="tag tag-accent whitespace-nowrap">On</span>
                            }
                        </button>
                    }
                </div>
            }

            <p class="mt-3 mb-0 text-xs text-ink/55">
                A clinic is matched to a gateway by its <strong>billing country</strong>,
                not by where a surgery stands — that is the registration a carrier checks.
                @ViewModel.UsableCount of @ViewModel.Gateways.Count can currently send.
            </p>
        </div>

        @if (ViewModel.IsEditing)
        {
            <div class="flex flex-col gap-3 px-6 py-5">
                <h5 class="m-0">
                    @(ViewModel.IsNew ? "New country" : $"{ViewModel.Country} gateway")
                </h5>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="field">
                        <label class="label-field" for="sms-country">Country</label>

                        @*
                            Picked, not typed. A mistyped country is a gateway that matches
                            no clinic and gives no sign of it — the practice simply never
                            receives a text.
                        *@
                        <select id="sms-country" class="input" @bind="ViewModel.Country">
                            <option value="">Choose…</option>
                            @* Named country, not code: a loop variable called code makes
                               @code parse as the code directive, and the errors point at
                               the block rather than the name. *@
                            @foreach (var country in ViewModel.CountryOptions)
                            {
                                <option value="@country">@country</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label class="label-field" for="sms-provider">Provider</label>
                        <input id="sms-provider" class="input" placeholder="e.g. Twilio"
                               @bind="ViewModel.ProviderName" @bind:event="oninput" />
                    </div>
                </div>

                <div class="field">
                    <label class="label-field" for="sms-url">SMS API URL</label>
                    <input id="sms-url" class="input" inputmode="url"
                           placeholder="https://api.example.com/v1/messages"
                           @bind="ViewModel.ApiUrl" @bind:event="oninput" />
                    <div class="mt-1 text-[11px] text-ink/55">
                        Must be https. A key posted over http is a key read by anything
                        between here and the provider.
                    </div>
                </div>

                @*
                    Authentication, as a choice rather than a header line somebody has to
                    get exactly right. It is the part of the request that must work before
                    any other part can be debugged — a wrong body comes back naming the
                    field, a wrong credential comes back 401 and nothing else.
                *@
                <div class="border-t-2 border-divider pt-3.5">
                    <div class="mb-2 text-[10px] tracking-[0.1em] text-neutral-600 uppercase">
                        How it authenticates
                    </div>

                    <div class="seg">
                        @foreach (var option in ViewModel.AuthTypeOptions)
                        {
                            @* Captured per iteration — the click lambda outlives the loop. *@
                            var authType = option;

                            <button type="button"
                                    class="@SegCss(ViewModel.AuthType == authType)"
                                    @onclick="() => ViewModel.SetAuthTypeCommand.Execute(authType)">
                                @SmsGatewaysViewModel.AuthTypeLabel(authType)
                            </button>
                        }
                    </div>

                    @if (ViewModel.IsApiKeyAuth)
                    {
                        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div class="field">
                                <label class="label-field" for="sms-auth-header">Key</label>
                                <input id="sms-auth-header" class="input"
                                       placeholder="e.g. X-API-Key"
                                       @bind="ViewModel.AuthHeaderName"
                                       @bind:event="oninput" />
                                <div class="mt-1 text-[11px] text-ink/55">
                                    The header the key is sent in.
                                </div>
                            </div>

                            <div class="field">
                                <label class="label-field" for="sms-key">Value</label>
                                <input id="sms-key" class="input" type="password"
                                       autocomplete="off"
                                       placeholder="@SecretPlaceholder"
                                       @bind="ViewModel.ApiKey" @bind:event="oninput" />
                                <div class="mt-1 text-[11px] text-ink/55">
                                    Sent exactly as typed, so a bearer token is
                                    <span class="font-mono">Bearer</span> and then the key.
                                </div>
                            </div>
                        </div>

                        <label class="radio mt-3">
                            <input type="checkbox" checked="@ViewModel.Base64EncodeApiKey"
                                   @onchange="e => ViewModel.Base64EncodeApiKey = (bool)e.Value!" />
                            <span class="dot"></span>
                            Base64-encode the value
                        </label>

                        <div class="mt-1 text-[11px] text-ink/55">
                            For providers that expect the key pre-encoded. The key is stored
                            as typed either way, so rotating it stays a paste.
                        </div>
                    }
                    else
                    {
                        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div class="field">
                                <label class="label-field" for="sms-auth-user">Username</label>
                                <input id="sms-auth-user" class="input"
                                       autocomplete="off"
                                       placeholder="e.g. account id"
                                       @bind="ViewModel.AuthUsername"
                                       @bind:event="oninput" />
                                <div class="mt-1 text-[11px] text-ink/55">
                                    Not a secret — shown here so the account a country sends
                                    under can be checked without retyping the password.
                                </div>
                            </div>

                            <div class="field">
                                <label class="label-field" for="sms-key">
                                    Password (optional)
                                </label>
                                <input id="sms-key" class="input" type="password"
                                       autocomplete="off"
                                       placeholder="@SecretPlaceholder"
                                       @bind="ViewModel.ApiKey" @bind:event="oninput" />
                                <div class="mt-1 text-[11px] text-ink/55">
                                    Sent as
                                    <span class="font-mono">Authorization: Basic</span> with
                                    the pair encoded at send. Leave it empty where the
                                    provider authenticates on the username alone — plenty
                                    document the key there and nothing after the colon.
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mt-2 text-[11px] text-ink/55">
                        @if (ViewModel.AuthTypeChangedNeedsSecret)
                        {
                            @* A blank box is not "keep the stored one" here. Called out,
                               because it otherwise looks optional exactly where it is not. *@
                            <span class="text-accent2">
                                The scheme has changed, so the stored credential no longer
                                applies — type the @ViewModel.SecretLabel.ToLowerInvariant()
                                for it.
                            </span>
                        }
                        else if (ViewModel.AuthTypeChanged)
                        {
                            @* Basic, where blank is allowed. The stored value is still
                               dropped rather than reused, which is worth saying — it is the
                               one edit where leaving the box alone changes the credential. *@
                            <span class="text-accent2">
                                The scheme has changed, so the stored credential is dropped
                                rather than reused. Leave this blank to save with no
                                password.
                            </span>
                        }
                        else if (ViewModel.HasStoredKey)
                        {
                            <text>
                                A credential is stored. It is never shown again — leave the
                                box blank to keep it, or type a new one to replace it.
                            </text>
                        }
                        else if (ViewModel.IsBasicAuth)
                        {
                            <text>
                                No password is stored. Saving it blank is allowed and sends
                                the username with nothing after the colon.
                            </text>
                        }
                        else
                        {
                            <text>Stored once and never displayed again.</text>
                        }
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="field">
                        <label class="label-field" for="sms-price">Price per message</label>
                        <input id="sms-price" class="input" inputmode="decimal"
                               placeholder="e.g. 0.045"
                               @bind="ViewModel.PricePerMessage" @bind:event="oninput" />
                        <div class="mt-1 text-[11px] text-ink/55">
                            What a practice in this country is charged for one message.
                            <strong>0 means included</strong> in their plan — which is why
                            the box cannot be left blank.
                        </div>
                    </div>

                    @*
                        A select for the same reason as the plan screen's: a typed code is
                        one nobody checks, and this one decides what a practice is charged
                        per message.
                    *@
                    <div class="field">
                        <label class="label-field" for="sms-credit">
                            Credit (optional)
                        </label>
                        <input id="sms-credit" class="input" type="number" min="0" step="1"
                               placeholder="No limit"
                               @bind="ViewModel.CreditLimit" @bind:event="oninput" />
                        <div class="mt-1 text-[11px] text-ink/55">
                            The most messages this country may send in total — the carrier's
                            bundle, not a monthly allowance. It counts down and does not
                            reset, so raising it is how a top-up is recorded. Blank means no
                            limit; <strong>0 stops the country sending</strong>.
                        </div>
                    </div>

                    <div class="field">
                        <label class="label-field" for="sms-currency">Currency</label>
                        <select id="sms-currency" class="input"
                                @bind="ViewModel.CurrencyCode">
                            @foreach (var option in ViewModel.CurrencyOptions)
                            {
                                <option value="@option.Code">@option.Label</option>
                            }
                        </select>
                        <div class="mt-1 text-[11px] text-ink/55">
                            Filled in from the country and worth changing where that is
                            wrong. It must match what the practice is billed in — the
                            currency on their plan, not the one they charge patients in.
                        </div>
                    </div>
                </div>

                <div class="field max-w-[260px]">
                    <label class="label-field" for="sms-sender">Sender id (optional)</label>
                    <input id="sms-sender" class="input" placeholder="e.g. MOLARGO"
                           @bind="ViewModel.SenderId" @bind:event="oninput" />
                    <div class="mt-1 text-[11px] text-ink/55">
                        What the message appears to come from. Some countries require this
                        pre-registered, some require a real number, and some rewrite it.
                    </div>
                </div>

                @*
                    The request itself, typed rather than written in code. Providers agree
                    on what a text message is and on nothing else about how to ask for one,
                    and a gateway table per country is pointless if a country can only be
                    moved to a provider somebody has already written a class for.
                *@
                <div class="border-t-2 border-divider pt-3.5">
                    <div class="mb-2 text-[10px] tracking-[0.1em] text-neutral-600 uppercase">
                        What gets posted
                    </div>

                    <div class="field max-w-[320px]">
                        <label class="label-field" for="sms-content-type">Content type</label>
                        <select id="sms-content-type" class="input"
                                @bind="ViewModel.ContentType">
                            @foreach (var option in ViewModel.ContentTypeOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                        <div class="mt-1 text-[11px] text-ink/55">
                            Decides how a value is escaped on the way in, not just the
                            header. A message carrying a quote is escaped one way for JSON
                            and another for a form.
                        </div>
                    </div>

                    <div class="field mt-3">
                        <label class="label-field" for="sms-payload">Body template</label>
                        <textarea id="sms-payload"
                                  class="input min-h-[132px] font-mono text-xs"
                                  spellcheck="false"
                                  @bind="ViewModel.PayloadTemplate"
                                  @bind:event="oninput"></textarea>
                        <div class="mt-1 text-[11px] text-ink/55">
                            Four tokens are filled in per message:
                            <code class="font-mono">@("{{To}}")</code>,
                            <code class="font-mono">@("{{Message}}")</code>,
                            <code class="font-mono">@("{{SenderId}}")</code> and
                            <code class="font-mono">@("{{ApiKey}}")</code>. Anything else
                            the provider wants — an account id, a route, a callback URL —
                            is typed in here as a constant.
                        </div>
                    </div>

                    <div class="field mt-3">
                        <label class="label-field" for="sms-headers">Headers</label>
                        <textarea id="sms-headers"
                                  class="input min-h-[62px] font-mono text-xs"
                                  spellcheck="false"
                                  placeholder="Accept: application/json"
                                  @bind="ViewModel.Headers"
                                  @bind:event="oninput"></textarea>
                        <div class="mt-1 text-[11px] text-ink/55">
                            One <span class="font-mono">Name: Value</span> per line, for
                            anything <em>besides</em> the credential — an
                            <span class="font-mono">Accept</span>, a route code. The auth
                            header is built from the section above; repeating it here sends
                            two of the same header, which providers refuse.
                        </div>
                    </div>

                    @*
                        Rendered against a sample, because a template full of tokens cannot
                        be checked against the provider's documentation. The sample carries
                        an apostrophe and a quotation mark on purpose: that is where a
                        hand-written JSON template breaks.
                    *@
                    <div class="mt-3 bg-surface p-2.5">
                        <div class="mb-1.5 text-[10px] tracking-[0.1em] text-neutral-600 uppercase">
                            Preview — exactly what would be sent
                        </div>

                    @*
                        Wrapped, not scrolled sideways. A form-encoded body is one long line
                        with every space percent-encoded, and an overflow-x box holding it
                        widened the whole page rather than itself — the panel grew a
                        horizontal scrollbar at the window's edge.
                    *@
                    @*
                        Wrapped rather than scrolled sideways: a form-encoded body is one
                        long line with every space percent-encoded, and an overflow-x box
                        holding it widened the whole page instead of itself.

                        The whitespace class is on each line and never on the box around
                        them. On the container it preserved the markup's own indentation
                        between the child elements too, and the request line came out
                        followed by two blank ones.
                    *@
                    <div class="font-mono text-[11px] leading-relaxed text-ink/80">
                        <div class="break-all whitespace-pre-wrap">POST @PreviewUrl</div>

                        <div class="break-all whitespace-pre-wrap">Content-Type: @ViewModel.Preview.ContentType</div>

                        @foreach (var header in ViewModel.Preview.Headers)
                        {
                            <div class="break-all whitespace-pre-wrap">@header.Key: @header.Value</div>
                        }

                        <div class="mt-1.5 break-all whitespace-pre-wrap">@ViewModel.Preview.Body</div>
                    </div>

                        <div class="mt-2 text-[11px] text-ink/55">
                            The key is masked here and is never read back out of the
                            database — the dots are all this screen has. A real send posts
                            this same request with the key filled in.
                        </div>
                    </div>
                </div>

                <div class="bg-surface p-2.5 text-xs text-ink/70">
                    <strong>The key is stored in this database in plain text.</strong>
                    <div class="mt-1">
                        The same as the mail account's app password, and worse: this one is
                        the vendor's, and it sends for every practice in the country. There
                        is no secret store here and no server to hold one. Treat the
                        database file as carrying it, and rotate the key at the provider if
                        a copy of the file ever leaves.
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2 border-t-2 border-divider pt-3">
                    <button class="btn btn-primary whitespace-nowrap"
                            disabled="@(!ViewModel.CanSave)"
                            @onclick="() => ViewModel.SaveCommand.ExecuteAsync()">
                        Save gateway
                    </button>

                    @*
                        The number sits with its own button rather than up in the form. It
                        is not part of the gateway — it is somebody's phone, typed for one
                        send and not stored — and a box among the saved fields would read as
                        something the country is configured with.
                    *@
                    <input class="input max-w-[170px]" inputmode="tel" autocomplete="off"
                           aria-label="Number to send a test message to"
                           placeholder="@TestNumberPlaceholder"
                           @bind="ViewModel.TestNumber" @bind:event="oninput" />

                    <button class="btn btn-secondary whitespace-nowrap"
                            disabled="@(!ViewModel.CanTest)"
                            @onclick="() => ViewModel.TestCommand.ExecuteAsync()">
                        Send test
                    </button>

                    <button class="btn btn-ghost text-xs"
                            @onclick="() => ViewModel.CloseCommand.Execute()">
                        Cancel
                    </button>

                    @if (!ViewModel.IsNew && ViewModel.Selected is { } selected)
                    {
                        <button class="btn btn-secondary ml-auto whitespace-nowrap"
                                @onclick="() => ViewModel.SetActiveCommand
                                    .ExecuteAsync(selected.GatewayId)">
                            @(selected.IsActive ? "Switch off" : "Switch on")
                        </button>

                        <button class="btn btn-ghost text-xs"
                                @onclick="() => ViewModel.DeleteCommand
                                    .ExecuteAsync(selected.GatewayId)">
                            Remove
                        </button>
                    }
                </div>

                @*
                    What the provider actually said. Its own block under the buttons because
                    a carrier's refusal runs to a sentence or two, and it answers a different
                    question from the preview above: the preview shows what would be posted,
                    and only a real send says whether the key still works, the sender id was
                    ever registered, or the balance is spent.
                *@
                <div class="text-[11px] text-ink/55">
                    @if (ViewModel.IsNew)
                    {
                        @* The credential exists only in the database, so there is nothing
                           to test until the row has been written. *@
                        <text>
                            <strong>Send test</strong> needs the gateway saved first — it
                            sends through what is stored, not what is typed above.
                        </text>
                    }
                    else
                    {
                        <text>
                            <strong>Send test</strong> sends a real message and is charged
                            like any other. A local number is read against
                            @ViewModel.Country; start with
                            <span class="font-mono">+</span> for anywhere else.
                        </text>
                    }
                </div>

                @if (ViewModel.TestResult is { } test)
                {
                    @* A failure here is the answer the test was asking for, not a broken
                       screen — which is why it is not in the error banner at the top. *@
                    <div class="@TestCss(test.Succeeded)">
                        <strong>@(test.Succeeded ? "Sent" : "Failed")</strong>@if (test.Number is { Length: > 0 } dialled)
                        {
                            <text> to <span class="font-mono">@dialled</span></text>
                        }

                        <div class="mt-1 break-words">@test.Detail</div>
                    </div>
                }
                else if (ViewModel.LastTestSummary is { } summary)
                {
                    <div class="text-[11px] text-ink/55">Last tested: @summary</div>
                }
            </div>
        }
        else
        {
            <div class="px-6 py-5">
                <p class="m-0 text-sm text-ink/55">
                    Pick a country to change its provider, or add one. Each country has at
                    most one gateway, and every practice billed in that country sends
                    through it.
                </p>

                <p class="mt-3 mb-0 text-xs text-ink/55">
                    <strong>Messages send, and they reach a charge.</strong>
                    The provider, key, URL, price and request shape are stored per country
                    and matched to a clinic by its billing country; a text posts the request
                    shown in the preview, and the monthly run on Platform → Billing adds the
                    previous month's messages to each clinic's charge at that country's rate.
                    What is still missing is collection: raising a charge writes a row, and
                    nothing takes money.
                </p>

                @*
                    In the right column, and only while nothing is open. Editing a gateway is
                    the one thing this pane is for, and a screen that showed both would make
                    the form scroll past a table nobody is reading at that moment. The figures
                    are a page-load away and the credit that matters most — the one on the
                    country being edited — is on the form itself.
                *@
                <div class="mt-4 border-t-2 border-divider pt-4">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                        <h2 class="m-0 font-heading text-lg">Usage by country</h2>

                        <span class="text-[13px] text-ink/55">
                            @ViewModel.SubscriberCount
                            @(ViewModel.SubscriberCount == 1 ? "subscriber" : "subscribers")
                            across @ViewModel.Usage.Count
                            @(ViewModel.Usage.Count == 1 ? "country" : "countries")
                        </span>
                    </div>

                    @if (ViewModel.Usage.Count == 0)
                    {
                        <p class="mt-2 mb-0 text-sm text-ink/55">
                            No subscribing clinics yet, so nothing has been sent.
                        </p>
                    }
                    else
                    {
                        @* One column now. Two fitted under the full page width; in a
                           column that is 1.4fr of it, a pair of cards puts the clinic list
                           and the credit bar into about three hundred pixels each. *@
                        <div class="mt-3 grid grid-cols-1 gap-3">
                            @foreach (var country in ViewModel.Usage)
                            {
                                <div class="bg-surface p-3">
                                    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                                        <span class="font-heading text-base">@country.CountryCode</span>

                                        <span class="text-[11px] text-ink/55">
                                            @if (country.HasGateway)
                                            {
                                                @country.ProviderName
                                            }
                                            else
                                            {
                                                @* Said plainly. A country with usage and no gateway is
                                                   messages already sent that nothing can account for. *@
                                                <strong>no gateway</strong>
                                            }
                                            · @country.ClinicCount
                                            @(country.ClinicCount == 1 ? "clinic" : "clinics")
                                        </span>
                                    </div>

                                    <div class="mt-2 flex flex-wrap items-baseline gap-x-5 gap-y-1 text-[13px]">
                                        <span>
                                            <strong>@country.SentThisMonth</strong>
                                            <span class="text-ink/55">this month</span>
                                        </span>

                                        <span>
                                            <strong>@country.SentTotal</strong>
                                            <span class="text-ink/55">all time</span>
                                        </span>

                                        @if (country.HasGateway)
                                        {
                                            <span class="text-ink/55">
                                                @MolargoFormat.MoneyIn(country.CurrencyCode,
                                                    country.CostThisMonth) this month ·
                                                @MolargoFormat.MoneyIn(country.CurrencyCode,
                                                    country.CostTotal) all time
                                            </span>
                                        }
                                    </div>

                                    @if (country.CreditLimit is { } limit)
                                    {
                                        <div class="mt-2">
                                            <div class="h-1.5 w-full bg-divider">
                                                @* Width as an inline style, not a Tailwind class. The
                                                   percentage is a number at runtime, and a class built
                                                   from one is a class the build never sees and never
                                                   emits. *@
                                                <div class="@(country.IsExhausted ? "bg-accent2-600" : "bg-accent-600") h-1.5"
                                                     style="width: @(country.PercentUsed ?? 0)%"></div>
                                            </div>

                                            <div class="mt-1 text-[11px] @(country.IsExhausted ? "text-accent2-700" : "text-ink/55")">
                                                @if (country.IsExhausted)
                                                {
                                                    <strong>
                                                        Credit spent — @country.SentTotal of @limit.
                                                        Nothing more will send from this country.
                                                    </strong>
                                                }
                                                else
                                                {
                                                    <text>
                                                        @country.Remaining of @limit left
                                                    </text>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-2 text-[11px] text-ink/55">No credit limit set.</div>
                                    }

                                    @if (country.Clinics.Count > 0)
                                    {
                                        <div class="mt-2.5 border-t border-divider pt-2">
                                            @foreach (var clinic in country.Clinics)
                                            {
                                                <div class="flex items-baseline justify-between gap-3 text-xs">
                                                    <span class="min-w-0 truncate">
                                                        @clinic.Name
                                                        @if (!clinic.SmsEnabled)
                                                        {
                                                            @* Worth saying beside a total. A clinic with
                                                               messages behind it and the switch off has
                                                               stopped, and the number alone reads as
                                                               somebody still sending. *@
                                                            <span class="text-ink/40">&nbsp;· texts off</span>
                                                        }
                                                    </span>

                                                    <span class="shrink-0 text-ink/55">
                                                        @clinic.SentThisMonth / @clinic.SentTotal
                                                    </span>
                                                </div>
                                            }

                                            <div class="mt-1 text-[10px] tracking-[0.06em] text-ink/40 uppercase">
                                                this month / all time
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <p class="mt-3 mb-0 text-xs text-ink/55">
                            Counted from messages that actually went — queued, failed and suppressed ones
                            are not counted and do not spend credit. These are running totals, not
                            invoices: a month reaches a clinic's charge on the following month's run, so
                            what is shown here for the current month has not been billed yet.
                        </p>
                    }
                </div>
            </div>
        }
    </div>


}

@code {
    /// <summary>
    /// The endpoint the preview prints, or a stand-in while the box is empty.
    /// </summary>
    /// <remarks>
    /// A property rather than an inline expression. The request line preserves whitespace
    /// so a body keeps its own breaks, and a conditional wrapped across three lines in the
    /// markup printed that indentation into the line itself.
    /// </remarks>
    private string PreviewUrl =>
        ViewModel.Preview.Url.Length > 0 ? ViewModel.Preview.Url : "(no API URL yet)";

    /// <summary>
    /// What the credential box says while it is empty.
    /// </summary>
    /// <remarks>
    /// Three states, not two. A stored credential under a scheme that has just been switched
    /// is not one that can be kept, and a box reading "leave blank to keep it" there would
    /// be telling somebody to do the one thing the save refuses.
    /// </remarks>
    private string SecretPlaceholder =>
        ViewModel.AuthTypeChangedNeedsSecret ? "Required for the new scheme"
        : ViewModel.AuthTypeChanged ? "Blank for no password"
        : ViewModel.HasStoredKey ? "Stored — leave blank to keep it"
        : ViewModel.IsBasicAuth ? "Optional"
        : "Required";

    /// <summary>A segmented option, filled while it is the chosen one.</summary>
    /// <remarks>
    /// Whole literal strings, like <see cref="RowCss"/> — Tailwind scans source text, so a
    /// class assembled from a base plus a conditional suffix never reaches the stylesheet.
    /// </remarks>
    private static string SegCss(bool on) => on ? "seg-opt seg-opt-on" : "seg-opt";

    /// <summary>The test result's box, green on a pass and red on a refusal.</summary>
    /// <remarks>Whole literal strings, for the reason on <see cref="RowCss"/>.</remarks>
    private static string TestCss(bool passed) =>
        passed
            ? "border-l-2 border-accent bg-surface p-2.5 text-[11px] text-ink/80"
            : "border-l-2 border-accent2 bg-surface p-2.5 text-[11px] text-ink/80";

    /// <summary>
    /// An example number in the gateway's own country, or a neutral one.
    /// </summary>
    /// <remarks>
    /// Matched to the country being edited, because the box accepts a local number and an
    /// example in the wrong national format is a worse hint than none — it suggests a shape
    /// the country does not use.
    /// </remarks>
    private string TestNumberPlaceholder => ViewModel.Country switch
    {
        "AU" => "0400 123 456",
        "NZ" => "021 123 4567",
        "PH" => "0917 123 4567",
        "GB" => "07700 900123",
        _ => "+61400123456",
    };

    /// <remarks>
    /// Whole literal strings, both branches — Tailwind scans source text, so a class
    /// assembled from a base plus a conditional suffix never reaches the stylesheet. The
    /// same pair the other list screens use.
    /// </remarks>
    private static string RowCss(bool on) =>
        on
            ? "flex w-full cursor-pointer items-center gap-2.5 border border-accent bg-accent-100 px-3 py-2 text-left font-[inherit]"
            : "flex w-full cursor-pointer items-center gap-2.5 border border-divider bg-transparent px-3 py-2 text-left font-[inherit] hover:border-ink/35";
}
