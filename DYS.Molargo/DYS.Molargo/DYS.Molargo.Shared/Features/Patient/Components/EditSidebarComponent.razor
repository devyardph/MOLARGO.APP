@using DYS.Molargo.Shared.Features.Patient.ViewModels

@* The form's first column: photo placeholder, and the operational flags. *@

<div class="flex flex-col gap-3 border-divider px-6 py-5 lg:border-r-2">
    @* The prototype's cross-hatched placeholder. Inline because the
       repeating-linear-gradient has no utility worth inventing for one element. *@
    <div class="grid h-[170px] w-[150px] place-items-center text-center font-mono text-[10px] text-neutral-700"
         style="background:repeating-linear-gradient(45deg,var(--color-neutral-200),var(--color-neutral-200) 6px,var(--color-neutral-300) 6px,var(--color-neutral-300) 12px)">
        patient photo<br />tablet camera
    </div>

    <button class="btn btn-secondary min-h-11 w-full justify-start" disabled
            title="Needs camera access and a document store">
        Capture photo
    </button>

    @if (Vm.Form.PatientNumber is { Length: > 0 } number)
    {
        <div>
            <div class="kpi-label">Patient number</div>
            <div class="font-heading text-lg font-extrabold">#@number</div>
            @if (Vm.IsNew)
            {
                @* Honest about it being provisional: two people creating a patient at
                   once are both shown this, and the second save takes the next one. *@
                <div class="text-[11px] text-ink/55">Assigned on save</div>
            }
        </div>
    }

    <div class="mt-3">
        <div class="kpi-label mb-2">Tags / flags</div>

        <div class="flex flex-col items-start gap-1.5">
            @foreach (var tag in FlagOptions)
            {
                <button class="@FlagCss(Vm.IsTagSet(tag))"
                        @onclick="() => Vm.ToggleTagCommand.Execute(tag)">
                    @PatientCss.TagLabel(tag)
                </button>
            }
        </div>

        <p class="mt-2 text-[11px] text-ink/55">
            Each of these changes how the practice treats a booking — a longer appointment,
            an interpreter to arrange, a payment conversation first.
        </p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PatientEditViewModel Vm { get; set; } = default!;

    /// <summary>
    /// Every flag except <c>None</c>, in declaration order so the list does not reshuffle.
    /// Read from the enum rather than listed, so a new flag appears here automatically.
    /// </summary>
    private static readonly PatientTags[] FlagOptions =
        Enum.GetValues<PatientTags>().Where(tag => tag != PatientTags.None).ToArray();

    private static string FlagCss(bool selected) =>
        selected
            ? "cursor-pointer whitespace-nowrap border-[1.5px] border-accent bg-accent-100 px-3.5 py-[7px] font-[inherit] text-xs text-accent-800"
            : "cursor-pointer whitespace-nowrap border-[1.5px] border-divider bg-bg px-3.5 py-[7px] font-[inherit] text-xs text-ink hover:bg-ink/7";
}
