@using DYS.Molargo.Shared.Features.Patient.ViewModels

@*
    The medical-history tab, in the same 1.4fr / 1fr split the overview uses: the alerts
    on the left, the questionnaire they were recorded from on the right.

    No longer one 720px column. The design stacks the two, which reads as a single list
    that keeps going — and the questionnaire, which is the evidence behind every alert
    above it, ended up below the fold on a patient with any history at all. Side by side,
    a clinician can check an alert against the answer that produced it without scrolling
    between them.

    Each column keeps its own tables narrow enough to read line by line, which is what the
    720px was protecting.
*@

<div class="grid lg:grid-cols-[1.4fr_1fr]">

    @* ---- left: the alerts ---- *@
    <div class="border-divider px-6 py-5 lg:border-r-2">
        <div class="mb-2 flex flex-wrap items-center gap-2.5">
            <h5 class="m-0 flex-1">Alerts and history</h5>
            <button class="btn btn-primary whitespace-nowrap"
                    @onclick="() => Vm.TakeMedicalHistoryCommand.Execute()">
                @(Vm.Record?.MedicalHistory is null ? "Take medical history" : "New questionnaire")
            </button>
        </div>

        @if (Vm.Alerts.Count == 0)
        {
            @* Not the same as a clean history. A record with nothing on it has not been
               asked, and saying so is what stops it being read as "no allergies". *@
            <div class="border-l-[3px] border-accent bg-accent-100 p-3 text-sm text-accent-800">
                No medical history recorded. Take one before treating.
            </div>
        }
        else
        {
            @*
                A refusal here is close to impossible — the button only renders on the day
                the alert was recorded — but the day can roll over between a render and a
                click, and a delete that silently did nothing would be worse than a notice
                nobody usually sees.
            *@
            @if (Vm.AlertRemovalRefusal is { Length: > 0 } refusal)
            {
                <NoticeComponent Kind="NoticeKind.Failure" Boxed Spacing="mb-3"
                                 Headline="Not removed." Message="@refusal" />
            }

            <div class="overflow-x-auto">
                <table class="w-full min-w-[560px] border-collapse text-sm">
                    <thead>
                        <tr>
                            <th class="head-cell whitespace-nowrap">Item</th>
                            <th class="head-cell">Detail</th>
                            <th class="head-cell whitespace-nowrap">Recorded</th>
                            <th class="head-cell"><span class="sr-only">Remove</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in Vm.AlertPage)
                        {
                            @* Captured per iteration — the click lambda outlives the loop. *@
                            var row = alert;

                            <tr>
                                <td class="body-cell whitespace-nowrap">
                                    <span class="@RecordCss.AlertKindCss(alert.Severity)">
                                        @RecordCss.AlertKindLabel(alert.Kind)
                                    </span>
                                </td>
                                <td class="body-cell">
                                    <strong>@alert.Summary</strong>
                                    @if (alert.Detail is { Length: > 0 } detail)
                                    {
                                        <span class="text-ink/55"> — @detail</span>
                                    }
                                </td>
                                <td class="body-cell whitespace-nowrap">
                                    @MolargoFormat.Date(alert.OnsetDate)
                                </td>
                                <td class="body-cell whitespace-nowrap text-right">
                                    @*
                                        Shown only on the day it was entered. An always-present
                                        button that refuses on click teaches staff that the
                                        screen argues with them; absence says the window has
                                        closed, which is the actual rule.
                                    *@
                                    @if (Vm.CanRemoveAlert(row))
                                    {
                                        @if (_confirmingRemove == row.Id)
                                        {
                                            @* Confirmed in place rather than with a dialog
                                               or a band, matching the documents tab — the
                                               two tabs delete the same way, so neither
                                               teaches a habit the other punishes. *@
                                            <button class="btn btn-primary text-xs"
                                                    @onclick="() => RemoveAsync(row.Id)">
                                                Remove permanently
                                            </button>
                                            <button class="btn btn-ghost text-xs"
                                                    @onclick="() => _confirmingRemove = null">
                                                Keep
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-ghost text-xs"
                                                    @onclick="() => _confirmingRemove = row.Id">
                                                Remove
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <PagerComponent Page="Vm.AlertPageIndex"
                            PageCount="Vm.AlertPageCount"
                            Total="Vm.AlertCount"
                            PageSize="PatientViewModel.AlertPageSize"
                            OnPrevious="() => Vm.PreviousAlertPageCommand.Execute()"
                            OnNext="() => Vm.NextAlertPageCommand.Execute()" />
        }
    </div>

    @* ---- right: the questionnaire it came from ---- *@
    <div class="border-t-2 border-divider px-6 py-5 lg:border-t-0">
        @if (Vm.Record?.MedicalHistory is { } history)
        {
            <div class="mb-2">
                <h5 class="m-0">Questionnaire</h5>
                <div class="mt-1 text-xs text-ink/55">
                    Version @history.FormVersion ·
                    completed @MolargoFormat.ShortDate(history.CompletedUtc)
                    @if (history.SignedByName is { Length: > 0 } signer)
                    {
                        <span> · signed by @signer</span>
                    }
                </div>
            </div>

            @if (Vm.MedicalHistoryAnswers.Count == 0)
            {
                <p class="text-[13px] text-ink/55">
                    The answers for this questionnaire are not on file.
                </p>
            }
            else
            {
                @*
                    Two columns here, not three. The narrower side cannot carry the
                    detail column as its own, so a detail sits under its question where
                    it belongs to it rather than beside it under a heading.
                *@
                <div class="flex flex-col">
                    @foreach (var answer in Vm.MedicalHistoryAnswers)
                    {
                        <div class="flex items-baseline gap-3 border-b border-divider py-1.5 text-[13px]">
                            <div class="flex-1">
                                @answer.QuestionText

                                @if (answer.Detail is { Length: > 0 } detail)
                                {
                                    <div class="text-[11px] text-ink/55">@detail</div>
                                }
                            </div>

                            <span class="whitespace-nowrap @RecordCss.AnswerCss(answer.YesNo)">
                                @RecordCss.AnswerLabel(answer.YesNo)
                            </span>
                        </div>
                    }
                </div>
            }

            @if (history.AdditionalNotes is { Length: > 0 } notes)
            {
                @* The patient's own words, kept as their own block and not folded into
                   the answers: it is the one part of this the patient wrote, and it
                   routinely says the thing no question asked about. *@
                <div class="mt-3 bg-surface p-2.5 text-[13px]">
                    <strong>Patient's own notes</strong>
                    <div class="mt-0.5 whitespace-pre-line text-ink/70">@notes</div>
                </div>
            }

            <p class="mt-2.5 text-xs text-ink/55">
                Each completion is kept as its own record — the answers given on the day
                are the clinical fact, so a new questionnaire never overwrites an old one.
            </p>
        }
        else
        {
            @* The right column always exists, so the split does not collapse on a patient
               with no questionnaire and leave the alerts oddly narrow. *@
            <h5 class="mt-0 mb-2">Questionnaire</h5>
            <p class="text-[13px] text-ink/55">
                None on file. Take one to record where the alerts came from — an alert
                with no questionnaire behind it cannot say who was asked, or when.
            </p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PatientViewModel Vm { get; set; } = default!;

    /// <summary>
    /// Which row is asking to be confirmed. View state, not view-model state: it is about
    /// this component's rendering and means nothing to the record.
    /// </summary>
    private Guid? _confirmingRemove;

    private async Task RemoveAsync(Guid alertId)
    {
        _confirmingRemove = null;
        await Vm.RemoveAlertCommand.ExecuteAsync(alertId);
    }
}
