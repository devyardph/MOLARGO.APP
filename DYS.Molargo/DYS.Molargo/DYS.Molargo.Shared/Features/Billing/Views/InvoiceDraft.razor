@page "/billing/invoices/{InvoiceId:guid}"
@using DYS.Molargo.Domain.Entities
@using DYS.Molargo.Shared.Features.Billing.Services
@using DYS.Molargo.Shared.Features.Billing.ViewModels
@inherits MvvmComponentBase<InvoiceDraftViewModel, Guid>

@*
    Building one invoice.

    Its own screen, not a column beside the day's list. The two are different jobs: the
    list is a day's takings read at a glance, this is a search and a running total. Sharing
    one pane left the catalogue picker about three hundred pixels wide on the screen where
    somebody is hunting an item number.

    Catalogue on the left, the invoice on the right — picking from a list into a basket,
    which is the shape everybody already knows. What was actually done sits above the
    catalogue, because for most invoices it is the whole answer and the search is the
    exception.

    Full-bleed — each band owns its own 24px padding, so the rules run edge to edge.
*@

<PageTitle>Invoice — @ViewModel.PatientName</PageTitle>

@if (ViewModel.NotFound)
{
    <div class="px-6 py-5">
        <h4>No such invoice</h4>
        <p class="text-sm text-ink/55">It does not exist, or it has been discarded.</p>
        <button class="btn btn-secondary" @onclick="() => ViewModel.BackCommand.Execute()">
            ← Back to billing
        </button>
    </div>
}
else if (ViewModel.Detail is { } detail)
{
    @* ---- header ---- *@
    <div class="flex flex-wrap items-center gap-3 border-b-2 border-divider px-6 py-3">
        <button class="btn btn-ghost whitespace-nowrap"
                @onclick="() => ViewModel.BackCommand.Execute()">
            ← Billing
        </button>

        <div class="min-w-0 flex-1">
            <div class="kpi-label">
                @(ViewModel.IsDraft ? "Draft invoice" : $"Invoice {detail.Invoice.InvoiceNumber}")
            </div>
            <h4 class="m-0 truncate">@ViewModel.PatientName</h4>
        </div>

        @if (ViewModel.IsDraft)
        {
            <button class="btn btn-ghost whitespace-nowrap"
                    @onclick="() => ViewModel.StartMoveCommand.Execute()">
                Bill someone else
            </button>
        }

        <button class="btn btn-ghost whitespace-nowrap"
                @onclick="() => ViewModel.OpenPatientCommand.Execute()">
            Open record
        </button>
    </div>

    @if (ViewModel.IsMovingPatient)
    {
        @*
            Moving the draft rather than rebuilding it. Discarding and retyping every line
            is what makes people leave an invoice on the wrong patient instead of fixing it.
        *@
        <div class="border-b border-divider bg-surface px-6 py-4">
            <h6 class="mt-0 mb-1.5">Move this draft to</h6>

            <div class="flex flex-wrap items-end gap-2.5">
                <div class="field min-w-[260px] flex-1">
                    <label class="label-field" for="move-search">Find the patient</label>
                    <input id="move-search" class="input" type="search"
                           placeholder="Search name, mobile or patient # …"
                           @bind="ViewModel.PatientSearch"
                           @bind:event="oninput"
                           @bind:after="() => ViewModel.SearchPatientsCommand.ExecuteAsync()" />
                </div>

                <button class="btn btn-ghost whitespace-nowrap"
                        @onclick="() => ViewModel.CancelMoveCommand.Execute()">
                    Cancel
                </button>
            </div>

            @if (ViewModel.PatientResults.Count > 0)
            {
                <div class="mt-2 flex flex-col gap-1">
                    @foreach (var found in ViewModel.PatientResults)
                    {
                        @* Captured per iteration — the click lambda outlives the loop. *@
                        var candidate = found;

                        <button type="button" class="@PatientCss"
                                @onclick="() => ViewModel.MoveToPatientCommand.ExecuteAsync(candidate.Id)">
                            <span class="flex-1 text-[13px] font-semibold">@candidate.FullName</span>
                            <span class="text-[11px] text-ink/55">#@candidate.PatientNumber</span>
                        </button>
                    }
                </div>
            }

            <p class="mt-2 mb-0 text-[11px] text-ink/55">
                Moving clears the attached visit — it belonged to the patient being moved
                away from — so what is suggested changes with it.
            </p>
        </div>
    }

    @if (ViewModel.Refusal is { Length: > 0 } refusal)
    {
        <NoticeComponent Kind="NoticeKind.Failure" Headline="Not done." Message="@refusal" />
    }

    @if (!ViewModel.IsDraft)
    {
        @* Issued invoices are not edited. Said here rather than by hiding the screen,
           because the link that reached it is a perfectly reasonable thing to click. *@
        <NoticeComponent Kind="NoticeKind.Warning" Boxed Spacing="mx-6 mt-4"
                         Headline="Already issued."
                         Message="This invoice has been billed, so its lines are fixed. Credit or void it from the billing list instead." />
    }

    <div class="grid lg:grid-cols-[1fr_1fr]">

        @* ================= left: what to bill ================= *@
        <div class="border-divider px-6 py-5 lg:border-r-2">

            @if (ViewModel.HasSuggestions)
            {
                <div class="mb-5">
                    <h5 class="mt-0 mb-1">What was done</h5>
                    <p class="mt-0 mb-2.5 text-[13px] text-ink/55">
                        Treatment on this patient's plan that nothing has billed yet. Adding
                        one here charges the practice's current fee and marks the treatment
                        invoiced, so it stops being offered.
                    </p>

                    <div class="flex flex-col gap-1.5">
                        @foreach (var row in ViewModel.Suggestions)
                        {
                            @* Captured per iteration — the click lambda outlives the loop. *@
                            var item = row;

                            <button type="button" class="@SuggestionCss" disabled="@(!ViewModel.IsDraft)"
                                    @onclick="() => ViewModel.AddSuggestedCommand.ExecuteAsync(item.TreatmentPlanItemId)">
                                <span class="font-mono text-[11px] text-neutral-600">
                                    @item.ItemNumber
                                </span>

                                <span class="min-w-0 flex-1">
                                    <span class="text-[13px] font-semibold">@item.Description</span>
                                    @if (item.ToothNumber is { Length: > 0 } tooth)
                                    {
                                        <span class="text-[13px] text-ink/55"> · tooth @tooth</span>
                                    }

                                    <span class="block text-[11px] text-ink/55">
                                        @*
                                            Delivered and merely booked are labelled apart.
                                            Nothing marks an item delivered yet, so booked
                                            work has to be billable on the day — but nobody
                                            should charge for treatment that has not
                                            happened without seeing that is what they are
                                            doing.
                                        *@
                                        @(item.IsDelivered ? "Done" : "Booked")
                                        @if (item.VisitLocal is { } visit)
                                        {
                                            <text> · @MolargoFormat.ShortDate(visit)</text>
                                        }
                                    </span>
                                </span>

                                <span class="whitespace-nowrap font-heading text-[13px] font-extrabold">
                                    @MolargoFormat.MoneyExact(item.Fee)
                                </span>
                            </button>
                        }
                    </div>
                </div>
            }

            <h5 class="mt-0 mb-1">Catalogue</h5>
            <p class="mt-0 mb-2.5 text-[13px] text-ink/55">
                Anything else being charged. Search by item number or wording.
            </p>

            <div class="mb-3 flex flex-wrap items-end gap-3">
                <div class="field min-w-[220px] flex-1">
                    <label class="label-field" for="draft-search">Find an item</label>
                    <input id="draft-search" class="input" type="search"
                           placeholder="e.g. 613, or crown"
                           @bind="ViewModel.Search" @bind:event="oninput" />
                </div>

                <div class="field w-[110px]">
                    <label class="label-field" for="draft-tooth">Tooth</label>
                    <input id="draft-tooth" class="input" placeholder="e.g. 26"
                           @bind="ViewModel.Tooth" @bind:event="oninput" />
                </div>
            </div>

            <p class="mt-0 mb-2.5 text-[11px] text-ink/55">
                A per-tooth item is refused without a tooth number — an unattributed line
                cannot be audited and the fund will reject the claim.
            </p>

            <div class="flex max-h-[520px] flex-col overflow-y-auto">
                @foreach (var row in ViewModel.Results)
                {
                    var choice = row;

                    <button type="button" class="@CatalogueCss" disabled="@(!ViewModel.IsDraft)"
                            @onclick="() => ViewModel.AddLineCommand.ExecuteAsync(choice.Code.Id)">
                        <span class="w-12 shrink-0 font-mono text-[11px] text-neutral-600">
                            @choice.ItemNumber
                        </span>

                        <span class="min-w-0 flex-1 text-[13px]">
                            @choice.Description
                            @if (choice.Code.IsPerTooth)
                            {
                                <span class="text-[11px] text-ink/55"> · per tooth</span>
                            }
                        </span>

                        <span class="whitespace-nowrap font-heading text-[13px] font-extrabold">
                            @MolargoFormat.MoneyExact(choice.Fee)
                        </span>
                    </button>
                }

                @if (ViewModel.Results.Count == 0)
                {
                    <p class="text-[13px] text-ink/55">
                        Nothing matches. The catalogue is maintained under
                        <strong>Billing → Item catalogue</strong>.
                    </p>
                }
            </div>
        </div>

        @* ================= right: the invoice ================= *@
        <div class="px-6 py-5">
            <h5 class="mt-0 mb-2.5">On this invoice</h5>

            @if (!ViewModel.HasLines)
            {
                <p class="text-[13px] text-ink/55">
                    Nothing on it yet. Add what was done, or pick from the catalogue — the
                    total is summed from the lines, never typed.
                </p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-sm">
                        <thead>
                            <tr>
                                <th class="head-cell">Item</th>
                                <th class="head-cell w-[64px] text-right">Qty</th>
                                <th class="head-cell w-[96px] text-right">Unit fee</th>
                                <th class="head-cell w-[96px] text-right">Discount</th>
                                <th class="head-cell text-right">Line</th>
                                <th class="head-cell"><span class="sr-only">Remove</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in ViewModel.Lines)
                            {
                                var line = row;

                                <tr>
                                    <td class="body-cell">
                                        <span class="font-mono text-[11px] text-neutral-600">
                                            @line.ItemNumber
                                        </span>
                                        <div>
                                            @line.Description
                                            @if (line.ToothNumber is { Length: > 0 } tooth)
                                            {
                                                <span class="text-ink/55"> · @tooth</span>
                                            }
                                        </div>
                                    </td>
                                    @*
                                        Editable on a draft: three visits of one plan get
                                        billed as a quantity, a fee gets matched to what was
                                        quoted, and a goodwill reduction goes on as a
                                        discount rather than as a credit note pretending the
                                        practice overcharged.

                                        Applied on change, not per keystroke: every edit is
                                        a save and a retotal, and doing that mid-number
                                        fought whoever was typing it.
                                    *@
                                    <td class="body-cell text-right">
                                        @if (ViewModel.IsDraft)
                                        {
                                            <input class="input w-full text-right" inputmode="numeric"
                                                   value="@line.Quantity"
                                                   @onchange="e => SaveQuantity(line, e)" />
                                        }
                                        else
                                        {
                                            @line.Quantity
                                        }
                                    </td>
                                    <td class="body-cell text-right">
                                        @if (ViewModel.IsDraft)
                                        {
                                            <input class="input w-full text-right" inputmode="decimal"
                                                   value="@InvoiceDraftViewModel.Money(line.UnitFee)"
                                                   @onchange="e => SaveFee(line, e)" />
                                        }
                                        else
                                        {
                                            @MolargoFormat.MoneyExact(line.UnitFee)
                                        }
                                    </td>
                                    <td class="body-cell text-right">
                                        @if (ViewModel.IsDraft)
                                        {
                                            <input class="input w-full text-right" inputmode="decimal"
                                                   value="@InvoiceDraftViewModel.Money(line.DiscountAmount)"
                                                   @onchange="e => SaveDiscount(line, e)" />
                                        }
                                        else
                                        {
                                            @MolargoFormat.MoneyExact(line.DiscountAmount)
                                        }
                                    </td>
                                    <td class="body-cell text-right whitespace-nowrap">
                                        @MolargoFormat.MoneyExact(line.LineTotal)
                                    </td>
                                    <td class="body-cell text-right">
                                        @if (ViewModel.IsDraft)
                                        {
                                            <button class="btn btn-ghost text-xs text-accent2-700"
                                                    aria-label="@($"Remove {line.Description}")"
                                                    @onclick="() => ViewModel.RemoveLineCommand.ExecuteAsync(line.Id)">
                                                ✕
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="mt-3 flex justify-between gap-3 border-t-2 border-divider pt-2.5">
                <strong>Invoice total</strong>
                <strong class="font-heading text-lg">
                    @MolargoFormat.MoneyExact(ViewModel.Total)
                </strong>
            </div>

            @if (ViewModel.IsDraft)
            {
                @if (ViewModel.Visits.Count > 0)
                {
                    <div class="mt-4">
                        <h6 class="mt-0 mb-1.5">Bill which visit?</h6>
                        <p class="mt-0 mb-2 text-[11px] text-ink/55">
                            Optional, and it narrows what is suggested above. Click the same
                            visit again to detach it.
                        </p>

                        <div class="flex flex-col gap-1.5">
                            @foreach (var row in ViewModel.Visits)
                            {
                                var visit = row;

                                <button type="button" class="@VisitCss(ViewModel.IsVisitAttached(visit.AppointmentId))"
                                        @onclick="() => ViewModel.AttachVisitCommand.ExecuteAsync(visit.AppointmentId)">
                                    <span class="flex-1 text-[13px]">
                                        @MolargoFormat.ShortDate(visit.StartLocal) · @visit.Reason
                                    </span>
                                    <span class="text-[11px] text-ink/55">@visit.ProviderName</span>
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="mt-4">
                    <h6 class="mt-0 mb-1.5">Payment terms</h6>
                    <div class="seg">
                        @foreach (var days in InvoiceDraftViewModel.Terms)
                        {
                            var term = days;

                            <button type="button" class="@SegCss(ViewModel.IsTerm(term))"
                                    @onclick="() => ViewModel.SetTermsCommand.Execute(term)">
                                @InvoiceDraftViewModel.TermLabel(term)
                            </button>
                        }
                    </div>
                    <p class="mt-1.5 mb-0 text-[11px] text-ink/55">@ViewModel.TermsLabel</p>
                </div>

                <div class="mt-4 flex flex-wrap gap-2">
                    <button class="btn btn-primary whitespace-nowrap"
                            disabled="@(ViewModel.IsBusy || !ViewModel.HasLines)"
                            @onclick="() => ViewModel.IssueCommand.ExecuteAsync()">
                        Issue invoice
                    </button>

                    <button class="btn btn-ghost whitespace-nowrap text-accent2-700"
                            disabled="@ViewModel.IsBusy"
                            @onclick="() => ViewModel.DiscardCommand.ExecuteAsync()">
                        Discard draft
                    </button>
                </div>

                <p class="mt-2 mb-0 text-[11px] text-ink/55">
                    Issuing assigns the invoice number and sets the due date. Until then
                    nothing has been billed and the draft can be discarded outright.
                    Payment is taken from the billing list once it is issued.
                </p>
            }
        </div>
    </div>

    <div class="px-6 py-3 font-mono text-[11px] text-neutral-700">WEB · INVOICE</div>
}

@code {
    [Parameter] public Guid InvoiceId { get; set; }

    protected override Guid NavigationParameter => InvoiceId;

    /// <remarks>
    /// Whole literal strings — Tailwind scans source text, so a class assembled from a base
    /// plus a conditional suffix never reaches the stylesheet.
    /// </remarks>
    private const string SuggestionCss =
        "flex w-full cursor-pointer items-center gap-3 border border-accent bg-accent-100 px-3 py-2 text-left font-[inherit] hover:bg-accent-100/70";

    private const string CatalogueCss =
        "flex w-full cursor-pointer items-center gap-3 border-b border-divider bg-transparent px-1 py-2 text-left font-[inherit] hover:bg-surface";

    private static string VisitCss(bool on) =>
        on
            ? "flex cursor-pointer items-center gap-3 border border-accent bg-accent-100 px-2.5 py-1.5 text-left font-[inherit]"
            : "flex cursor-pointer items-center gap-3 border border-divider bg-transparent px-2.5 py-1.5 text-left font-[inherit] hover:border-ink/35";

    private static string SegCss(bool on) => on ? "seg-opt seg-opt-on" : "seg-opt";

    private const string PatientCss =
        "flex w-full cursor-pointer items-center gap-3 border border-divider bg-bg px-2.5 py-1.5 text-left font-[inherit] hover:border-accent";

    /// <summary>
    /// Applies an edited figure, ignoring anything that is not a number yet.
    /// </summary>
    /// <remarks>
    /// Rejected quietly rather than refused. A half-typed number is not an error worth a
    /// banner — the field still holds what the person typed, and the line still holds the
    /// figure it had.
    /// </remarks>
    private Task SaveQuantity(InvoiceLine line, ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var quantity)
            ? ViewModel.UpdateLineCommand.ExecuteAsync(
                new LineEdit(line.Id, quantity, line.UnitFee, line.DiscountAmount))
            : Task.CompletedTask;

    private Task SaveFee(InvoiceLine line, ChangeEventArgs e) =>
        decimal.TryParse(e.Value?.ToString(), out var fee)
            ? ViewModel.UpdateLineCommand.ExecuteAsync(
                new LineEdit(line.Id, line.Quantity, fee, line.DiscountAmount))
            : Task.CompletedTask;

    private Task SaveDiscount(InvoiceLine line, ChangeEventArgs e) =>
        decimal.TryParse(e.Value?.ToString(), out var discount)
            ? ViewModel.UpdateLineCommand.ExecuteAsync(
                new LineEdit(line.Id, line.Quantity, line.UnitFee, discount))
            : Task.CompletedTask;
}
