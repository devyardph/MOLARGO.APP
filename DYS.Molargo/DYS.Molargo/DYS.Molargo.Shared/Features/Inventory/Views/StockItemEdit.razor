@page "/inventory/stock/new"
@page "/inventory/stock/{StockItemId:guid}"
@using DYS.Molargo.Shared.Features.Inventory.ViewModels
@inherits MvvmComponentBase<StockItemEditViewModel, Guid>

@*
    The prototype's stock item create/edit screen: a header bar with back, delete and
    save, the saved / confirm / archived banners, then a 1.4fr / 1fr grid — the form on
    the left, context on the right.

    Two routes, one screen. "/inventory/stock/new" and "/inventory/stock/{id}" are the
    same form with the same fields and the same save.

    Delete archives. The design says so itself — "the item is archived, not erased" — and
    it has to: the movements behind the item are what trace a batch to a patient, and a
    deleted item orphans the record a product recall depends on.
*@

<PageTitle>@ViewModel.Title — Molargo</PageTitle>

@if (ViewModel.NotFound)
{
    <div class="px-6 py-5">
        <h4>No such item</h4>
        <p class="text-sm text-ink/55">
            That stock item does not exist, or it has been archived.
        </p>
        <button class="btn btn-secondary" @onclick="() => ViewModel.BackCommand.Execute()">
            ← Back to inventory
        </button>
    </div>
}
else
{
    @* ---- header bar ---- *@
    <div class="flex flex-wrap items-center gap-4 border-b-2 border-divider px-6 py-3">
        <h4 class="m-0">@ViewModel.Title</h4>

        <button class="btn btn-secondary ml-auto whitespace-nowrap"
                @onclick="() => ViewModel.BackCommand.Execute()">
            Back to inventory
        </button>

        @if (ViewModel.IsExisting && ViewModel.IsEditing)
        {
            <button class="btn btn-secondary whitespace-nowrap text-accent-700"
                    @onclick="() => ViewModel.AskArchiveCommand.Execute()">
                Delete item…
            </button>
        }

        @if (ViewModel.IsEditing)
        {
            <button class="btn btn-primary whitespace-nowrap"
                    disabled="@ViewModel.IsBusy"
                    @onclick="() => ViewModel.SaveCommand.ExecuteAsync()">
                Save item
            </button>
        }
    </div>

    @if (ViewModel.HasError)
    {
        <NoticeComponent Kind="NoticeKind.Failure"
                         Headline="@ViewModel.ErrorHeadline"
                         Message="@ViewModel.ErrorMessage" />
    }

    @if (ViewModel.Stage == StockEditStage.Saved)
    {
        <NoticeComponent Headline="Saved." Message="@ViewModel.SavedMessage">
            <Action>
                <button class="btn btn-ghost whitespace-nowrap"
                        @onclick="() => ViewModel.BackCommand.Execute()">
                    Done →
                </button>
            </Action>
        </NoticeComponent>
    }

    @if (ViewModel.Stage == StockEditStage.ConfirmingArchive)
    {
        <div class="flex flex-wrap items-center gap-4 border-b-2 border-ink/25 bg-surface px-6 py-3 text-sm text-ink"
             role="alert">
            <strong>Delete this item?</strong>
            <span>
                Stock history, batch links and PO lines are retained — the item is
                archived, not erased.
            </span>

            <div class="ml-auto flex gap-2">
                <button class="btn btn-primary whitespace-nowrap"
                        disabled="@ViewModel.IsBusy"
                        @onclick="() => ViewModel.ConfirmArchiveCommand.ExecuteAsync()">
                    Yes — archive item
                </button>
                <button class="btn btn-secondary whitespace-nowrap"
                        @onclick="() => ViewModel.CancelArchiveCommand.Execute()">
                    Keep item
                </button>
            </div>
        </div>
    }

    @if (ViewModel.Stage == StockEditStage.Archived)
    {
        <NoticeComponent Headline="Archived."
                         Message="Removed from the active stock list · movements and order lines retained">
            <Action>
                <button class="btn btn-ghost whitespace-nowrap"
                        @onclick="() => ViewModel.BackCommand.Execute()">
                    Back to inventory →
                </button>
            </Action>
        </NoticeComponent>
    }

    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr]">
        @* ---- the form ---- *@
        <div class="flex flex-col gap-4 border-divider px-6 py-5 lg:border-r-2">
            <div class="field max-w-[420px]">
                <label for="stock-name">Item name</label>
                <input id="stock-name" class="input"
                       placeholder="e.g. Septanest 4% 1:100k"
                       @bind="ViewModel.Name" @bind:event="oninput" />
                <FieldErrorComponent Message="@ViewModel.ErrorFor(nameof(ViewModel.Name))" />
            </div>

            <div>
                <div class="mb-2 text-[10px] tracking-[0.1em] text-neutral-600 uppercase">
                    Category
                </div>
                <div class="flex flex-wrap gap-2">
                    @foreach (var category in StockItemEditViewModel.Categories)
                    {
                        <button type="button" class="@ChipCss(ViewModel.Category == category)"
                                @onclick="() => ViewModel.SelectCategoryCommand.Execute(category)">
                            @category
                        </button>
                    }

                    @if (ViewModel.Category is { Length: > 0 } own
                        && !StockItemEditViewModel.Categories.Contains(own))
                    {
                        @* A category set elsewhere. Shown as a chip rather than dropped,
                           so editing an item does not silently recategorise it. *@
                        <button type="button" class="@ChipCss(true)"
                                @onclick="() => ViewModel.SelectCategoryCommand.Execute(own)">
                            @own
                        </button>
                    }
                </div>
            </div>

            <div>
                <div class="mb-2 text-[10px] tracking-[0.1em] text-neutral-600 uppercase">
                    Preferred supplier
                </div>

                @if (ViewModel.Suppliers.Count == 0)
                {
                    <p class="m-0 text-sm text-ink/55">
                        No suppliers set up. An item with no supplier can be counted but
                        not ordered — <strong>Add to PO</strong> will refuse it.
                    </p>
                }
                else
                {
                    <div class="flex flex-wrap gap-2">
                        @foreach (var supplier in ViewModel.Suppliers)
                        {
                            <button type="button"
                                    class="@ChipCss(ViewModel.SupplierId == supplier.Id)"
                                    @onclick="() => ViewModel.SelectSupplierCommand.Execute(supplier.Id)">
                                @supplier.Name
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="flex flex-wrap gap-3.5">
                <div class="field w-[110px]">
                    <label for="stock-onhand">On hand</label>
                    <input id="stock-onhand" class="input" type="number" step="1"
                           disabled="@(!ViewModel.CanEditOnHand)"
                           @bind="ViewModel.OnHand" />
                    <FieldErrorComponent Message="@ViewModel.ErrorFor(nameof(ViewModel.OnHand))" />
                </div>

                <div class="field w-[110px]">
                    <label for="stock-reorder-at">Reorder at</label>
                    <input id="stock-reorder-at" class="input" type="number" step="1"
                           @bind="ViewModel.ReorderLevel" />
                    <FieldErrorComponent Message="@ViewModel.ErrorFor(nameof(ViewModel.ReorderLevel))" />
                </div>

                <div class="field w-[110px]">
                    <label for="stock-reorder-qty">Order qty</label>
                    <input id="stock-reorder-qty" class="input" type="number" step="1"
                           @bind="ViewModel.ReorderQuantity" />
                </div>

                <div class="field w-[130px]">
                    <label for="stock-unit">Unit</label>
                    <input id="stock-unit" class="input" placeholder="each, box of 100"
                           @bind="ViewModel.Unit" @bind:event="oninput" />
                </div>

                <div class="field w-[110px]">
                    <label for="stock-cost">Unit cost</label>
                    <input id="stock-cost" class="input" type="number" step="0.01"
                           @bind="ViewModel.UnitCost" />
                </div>
            </div>

            @if (!ViewModel.CanEditOnHand)
            {
                @*
                    Said where the disabled box is, not in a footnote. Typing over a
                    balance that is the sum of a ledger is the mistake this prevents, and
                    a greyed box with no reason looks like a bug.
                *@
                <p class="m-0 text-xs text-ink/55">
                    On hand is the sum of this item's movements, so it is not typed here.
                    Correct a count with <strong>Use / adjust</strong> on the stock list,
                    which records who changed it and by how much.
                </p>
            }

            <div class="flex flex-wrap gap-3.5">
                <div class="field w-[170px]">
                    <label for="stock-sku">Our code</label>
                    <input id="stock-sku" class="input" placeholder="bench code"
                           @bind="ViewModel.Sku" @bind:event="oninput" />
                </div>

                <div class="field w-[170px]">
                    <label for="stock-supplier-code">Supplier's code</label>
                    <input id="stock-supplier-code" class="input" placeholder="catalogue no."
                           @bind="ViewModel.SupplierItemCode" @bind:event="oninput" />
                </div>
            </div>

            <div class="flex items-center gap-3.5 bg-surface p-3">
                <button type="button" class="@ChipCss(ViewModel.RequiresBatchTracking)"
                        @onclick="() => ViewModel.ToggleBatchCommand.Execute()">
                    Batch
                </button>

                <div class="flex-1 text-[13px]">
                    <strong>Track by batch &amp; expiry</strong>
                    <div class="text-xs text-ink/55">
                        Required for implants, anaesthetics and restorative materials —
                        anything a recall could reach. A batch-tracked item refuses a
                        receipt with no batch number.
                    </div>
                </div>
            </div>

            @if (ViewModel.ShowOpeningBatch)
            {
                <div class="flex flex-wrap gap-3.5">
                    <div class="field w-[170px]">
                        <label for="stock-batch">Batch on the shelf now</label>
                        <input id="stock-batch" class="input"
                               @bind="ViewModel.OpeningBatch" @bind:event="oninput" />
                        <FieldErrorComponent Message="@ViewModel.ErrorFor(nameof(ViewModel.OpeningBatch))" />
                    </div>

                    <div class="field w-[150px]">
                        <label for="stock-expiry">Expiry</label>
                        <input id="stock-expiry" class="input" type="date"
                               @bind="ViewModel.OpeningExpiry" />
                    </div>
                </div>
            }
        </div>

        @* ---- context ---- *@
        <div class="flex flex-col gap-3 px-6 py-5">
            <h6 class="m-0">Reorder behaviour</h6>
            <div class="bg-surface p-2.5 text-[13px] text-ink/70">
                When on hand falls to <strong>reorder at</strong> or below, the item is
                flagged Low on the stock list and <strong>Add to PO</strong> puts
                <strong>order qty</strong> of it on a draft order for the preferred
                supplier.
            </div>

            @if (ViewModel.IsExisting)
            {
                <h6 class="mt-2 mb-0">Movements</h6>

                @if (ViewModel.Movements.Count == 0)
                {
                    <p class="m-0 text-sm text-ink/55">
                        Nothing recorded against this item yet.
                    </p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full border-collapse">
                            <thead>
                                <tr>
                                    <th class="head-cell">When</th>
                                    <th class="head-cell">What</th>
                                    <th class="head-cell">Change</th>
                                    <th class="head-cell">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movement in ViewModel.Movements)
                                {
                                    <tr>
                                        <td class="body-cell text-xs">
                                            @MolargoFormat.DayLabel(movement.OccurredUtc)
                                        </td>
                                        <td class="body-cell text-xs">
                                            @InventoryViewModel.KindLabel(movement.Kind)

                                            @if (movement.BatchNumber is { Length: > 0 } batch)
                                            {
                                                <div class="font-mono text-[11px] text-ink/55">
                                                    @batch
                                                </div>
                                            }
                                        </td>
                                        <td class="body-cell @(movement.QuantityChange < 0m ? "text-accent-800" : "")">
                                            @movement.QuantityChange.ToString("+0.##;-0.##;0")
                                        </td>
                                        <td class="body-cell">
                                            @movement.BalanceAfter.ToString("0.##")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="m-0 text-xs text-ink/55">
                        The last 30 movements, newest first. This is the history the on-hand
                        figure is derived from.
                    </p>
                }
            }

            <h6 class="mt-2 mb-0">Not recorded</h6>
            <div class="text-xs text-ink/55">
                @*
                    The design's right column carries a barcode, a storage location, a
                    created-by line and a last-stocktake variance. None of them exist on
                    the item, and an audit line saying "S. Reid, 12 Feb 25" that nothing
                    stamped is the kind of detail a dispute would rest on.
                *@
                No barcode — scanning needs a reader and a tablet app.<br />
                No storage location — the design has one; the item does not carry it.<br />
                No audit trail of edits — who changed a level and when is not stamped.
            </div>
        </div>
    </div>
}

<div class="px-6 pb-6 font-mono text-[11px] text-neutral-700">
    WEB · STOCK ITEM
</div>

@code {
    /// <summary>Null on the "new" route.</summary>
    [Parameter] public Guid? StockItemId { get; set; }

    protected override Guid NavigationParameter => StockItemId ?? Guid.Empty;

    /// <summary>
    /// A selectable chip — category, supplier, or the batch toggle.
    /// </summary>
    /// <remarks>
    /// Delegates to the shared mapper rather than keeping its own copy of the two class
    /// strings. This was the third copy, and it is how it stayed white-on-accent after the
    /// other two were changed — the accent is now light enough that white fails contrast
    /// on it.
    /// </remarks>
    private static string ChipCss(bool isOn) =>
        DYS.Molargo.Shared.Components.ChipCss.Chip(isOn);
}
