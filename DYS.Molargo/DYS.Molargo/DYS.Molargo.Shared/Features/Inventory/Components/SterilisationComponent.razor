@using DYS.Molargo.Shared.Features.Inventory.ViewModels

@*
    The design's sterilisation pane: today's autoclave cycles on the left, tray-to-patient
    traceability on the right.

    Releasing a load is a separate act from running the cycle, and it is signed. A failed
    cycle, or one whose chemical indicator did not pass, cannot be released at all — the
    instruments are not sterile, and a record saying a named person released them is worse
    than no record.
*@

<div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr]">
    <div class="border-divider px-6 py-5 lg:border-r-2">
        <div class="mb-3 flex flex-wrap items-baseline gap-3">
            <h5 class="m-0">Autoclave cycles — today</h5>

            @if (Vm.AwaitingReleaseCount > 0)
            {
                <span class="tag tag-accent2">@Vm.AwaitingReleaseCount awaiting release</span>
            }
        </div>

        @if (Vm.Cycles.Count == 0)
        {
            <p class="text-sm text-ink/55">
                No cycles recorded today. Each load's unit, cycle number, peak temperature,
                hold time and indicator results are the record an audit asks for.
            </p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead>
                        <tr>
                            <th class="head-cell">Unit</th>
                            <th class="head-cell">Cycle</th>
                            <th class="head-cell">Time</th>
                            <th class="head-cell">Parameters</th>
                            <th class="head-cell">Indicators</th>
                            <th class="head-cell">Result</th>
                            <th class="head-cell">Released by</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cycle in Vm.Cycles)
                        {
                            <tr>
                                <td class="body-cell">
                                    <strong>@cycle.SterilisorName</strong>

                                    @if (cycle.LoadContents is { Length: > 0 } contents)
                                    {
                                        <div class="text-[11px] text-ink/55">@contents</div>
                                    }
                                </td>
                                <td class="body-cell font-mono text-xs">#@cycle.CycleNumber</td>
                                <td class="body-cell text-xs">
                                    @MolargoFormat.DayTime(cycle.StartedUtc)

                                    @if (cycle.CompletedUtc is null)
                                    {
                                        <div class="text-ink/55">still running</div>
                                    }
                                </td>
                                <td class="body-cell text-xs">@cycle.Parameters</td>
                                <td class="body-cell text-xs">
                                    @* Named separately from the result. A cycle the machine
                                       calls a pass with a failed indicator is exactly the
                                       case release must refuse, and a single "Passed" chip
                                       would hide it. *@
                                    @if (cycle.CompletedUtc is null)
                                    {
                                        @*
                                            Nothing to report on a load still in the
                                            chamber. ChemicalIndicatorPassed is a bool and
                                            so reads false before anyone has looked at the
                                            strip — printing that as FAIL raises an alarm
                                            about a cycle that has not failed, on the one
                                            column that has to mean something when it
                                            shouts.
                                        *@
                                        <span class="text-ink/55">not read yet</span>
                                    }
                                    else
                                    {
                                        <div class="@(cycle.ChemicalIndicatorPassed ? "" : "font-bold text-accent-800")">
                                            Chemical: @(cycle.ChemicalIndicatorPassed ? "pass" : "FAIL")
                                        </div>
                                        <div class="@(cycle.BiologicalIndicatorPassed == false ? "font-bold text-accent-800" : "text-ink/55")">
                                            Biological:
                                            @(cycle.BiologicalIndicatorPassed switch
                                            {
                                                true => "pass",
                                                false => "FAIL",
                                                null => "not run",
                                            })
                                        </div>
                                    }
                                </td>
                                <td class="body-cell">
                                    <span class="@InventoryCss.CycleResultTag(cycle.Result)">
                                        @InventoryCss.CycleResultLabel(cycle.Result)
                                    </span>
                                </td>
                                <td class="body-cell text-xs">
                                    @if (cycle.ReleasedBy is { Length: > 0 } releasedBy)
                                    {
                                        <strong>@releasedBy</strong>
                                        <div class="text-ink/55">
                                            @MolargoFormat.DayTime(cycle.ReleasedUtc)
                                        </div>
                                    }
                                    else if (cycle.AwaitingRelease)
                                    {
                                        <button class="btn btn-secondary text-xs whitespace-nowrap"
                                                disabled="@Vm.IsBusy"
                                                @onclick="() => Vm.ReleaseCycleCommand.ExecuteAsync(cycle.CycleId)">
                                            Release load
                                        </button>
                                    }
                                    else if (cycle.Result is SterilisationResult.Failed
                                        or SterilisationResult.Aborted)
                                    {
                                        @* No button at all, not a disabled one. The load is
                                           reprocessed; there is nothing to sign. *@
                                        <span class="font-semibold text-accent-800">
                                            Reprocess — not released
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-ink/55">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="mt-3 text-xs text-ink/55">
                @*
                    Said plainly. The design implies the autoclave writes its own cycle
                    log; it does not, and a practice believing the machine is logging
                    would stop keeping the paper printout that is its actual record.
                *@
                <strong>Release load</strong> signs the load off for use against your
                login, and is refused on a failed or aborted cycle or a failed chemical
                indicator. <strong>No sterilisor is connected</strong> — cycle parameters
                are recorded from the machine's printout rather than read from it, so keep
                the printout.
            </p>
        }
    </div>

    <div class="flex flex-col gap-3 px-6 py-5">
        <h5 class="m-0">Traceability — tray to patient</h5>

        @if (Vm.Traceability.Count == 0)
        {
            <p class="text-sm text-ink/55">
                No trays recorded against today's cycles. A tray links a load to the
                patient it was used on, which is the chain a recall or an audit follows.
            </p>
        }
        else
        {
            @foreach (var (cycle, use) in Vm.Traceability)
            {
                <div class="bg-surface p-3 text-[13px]">
                    <strong>@(use.PackIdentifier ?? "Unnamed pack")</strong>
                    <span class="text-ink/70">
                        · @cycle.SterilisorName cycle #@cycle.CycleNumber
                    </span>

                    <div class="text-xs text-ink/55">
                        @MolargoFormat.DayTime(use.UsedUtc) → @use.PatientName

                        @if (!cycle.AwaitingRelease && cycle.ReleasedUtc is not null)
                        {
                            @(" ✓")
                        }
                    </div>

                    @if (cycle.Result is SterilisationResult.Failed
                        or SterilisationResult.Aborted)
                    {
                        @*
                            The row this whole panel exists for: a tray from a failed load
                            that has already been used on someone. It is the only reason
                            the chain is worth keeping, so it is stated rather than styled.
                        *@
                        <div class="mt-1 text-xs font-bold text-accent-800">
                            This load failed. @use.PatientName must be followed up.
                        </div>
                    }
                    else if (cycle.ReleasedUtc is null)
                    {
                        <div class="mt-1 text-xs font-semibold text-accent-800">
                            Used before the load was released.
                        </div>
                    }
                </div>
            }
        }

        <p class="mt-1 text-xs text-ink/55">
            The design has every tray barcode-scanned at the chair. There is no scanner and
            no tablet app, so a tray is linked to a patient by being recorded here — which
            means the chain is only as complete as what gets entered.
        </p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public InventoryViewModel Vm { get; set; } = default!;
}
