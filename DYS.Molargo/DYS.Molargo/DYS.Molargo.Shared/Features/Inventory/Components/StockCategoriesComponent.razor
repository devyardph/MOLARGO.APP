@using DYS.Molargo.Shared.Features.Inventory.ViewModels

@*
    The categories stock is filed under.

    The same list-then-editor split as Suppliers beside it, and as the consent templates and
    medical-history questions in Admin. The order of the list is the order the chips appear
    in on the item editor, so moving a row here is a real edit rather than a display
    preference — which is why the arrows sit in the editor with the other actions instead of
    on every row.
*@

<div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr]">
    <div class="border-divider px-6 py-5 lg:border-r-2">
        <div class="mb-3 flex flex-wrap items-center gap-2.5">
            <h5 class="m-0 flex-1">Stock categories</h5>

            <button class="btn btn-secondary whitespace-nowrap"
                    @onclick="() => Vm.NewCategoryCommand.Execute()">
                New category
            </button>
        </div>

        @if (Vm.Categories.Count == 0)
        {
            <p class="text-sm text-ink/55">
                No categories yet. The stock table groups by these, so until there is one
                every item sorts on its own.
            </p>
        }
        else
        {
            <div class="flex flex-col gap-2">
                @foreach (var row in Vm.Categories)
                {
                    @* Captured per iteration — the click lambda outlives the loop. *@
                    var category = row;
                    var count = Vm.ItemsIn(category.Name);

                    <button type="button"
                            class="@RowCss(Vm.EditingCategory?.Id == category.Id)"
                            @onclick="() => Vm.SelectCategoryCommand.Execute(category.Id)">
                        <span class="flex-1 text-[13px] font-bold">@category.Name</span>

                        @* The number that decides whether it can be retired, in the list
                           so the weight of the decision is visible before it is opened. *@
                        <span class="tag tag-neutral whitespace-nowrap">
                            @(count == 1 ? "1 item" : $"{count} items")
                        </span>

                        @if (!category.IsActive)
                        {
                            <span class="tag tag-outline whitespace-nowrap">Retired</span>
                        }
                    </button>
                }
            </div>
        }

        <p class="mt-3 mb-0 text-xs text-ink/55">
            Items are filed by the category's <strong>name</strong>, not by a reference to
            it — so renaming one carries every item with it, and one with items in it
            cannot be retired until they are moved.
        </p>
    </div>

    @if (Vm.EditingCategory is { } editing)
    {
        <div class="flex flex-col gap-3 px-6 py-5">
            <div class="flex flex-wrap items-baseline gap-2.5">
                <h5 class="m-0">
                    @(Vm.CategoryIsNew ? "New category" : editing.Name)
                </h5>

                @if (!Vm.CategoryIsActive && !Vm.CategoryIsNew)
                {
                    <span class="tag tag-outline">Retired</span>
                }
            </div>

            <div class="field max-w-[420px]">
                <label class="label-field" for="category-name">Category name</label>
                <input id="category-name" class="input"
                       placeholder="e.g. Infection control"
                       @bind="Vm.CategoryName" @bind:event="oninput" />
            </div>

            @if (!Vm.CategoryIsNew)
            {
                <div>
                    <span class="label-field">Order on the item editor</span>

                    <div class="mt-1 flex flex-wrap items-center gap-2">
                        <button class="btn btn-secondary whitespace-nowrap"
                                disabled="@(!Vm.CanMoveCategoryUp)"
                                @onclick="() => Vm.MoveCategoryUpCommand.ExecuteAsync()">
                            ↑ Move up
                        </button>

                        <button class="btn btn-secondary whitespace-nowrap"
                                disabled="@(!Vm.CanMoveCategoryDown)"
                                @onclick="() => Vm.MoveCategoryDownCommand.ExecuteAsync()">
                            ↓ Move down
                        </button>

                        <span class="text-xs text-ink/55">
                            The ones reached for most can sit first.
                        </span>
                    </div>
                </div>

                <div class="bg-surface p-2.5 text-xs text-ink/70">
                    @{
                        var count = Vm.ItemsIn(editing.Name);
                    }

                    @if (count == 0)
                    {
                        <text>
                            Nothing is filed under this, so renaming or retiring it changes
                            nothing on the shelves.
                        </text>
                    }
                    else
                    {
                        <text>
                            <strong>@(count == 1 ? "1 item is" : $"{count} items are")
                            filed under this.</strong>
                            Renaming moves them all with it. Retiring is refused until they
                            are moved somewhere else — an item whose category is off the
                            chips can be seen in the table and not corrected in the editor.
                        </text>
                    }
                </div>
            }

            <div class="flex flex-wrap items-center gap-2 border-t-2 border-divider pt-3">
                <button class="btn btn-primary whitespace-nowrap"
                        disabled="@(!Vm.CanSaveCategory)"
                        @onclick="() => Vm.SaveCategoryCommand.ExecuteAsync()">
                    @(Vm.CategoryIsNew ? "Add category" : "Save category")
                </button>

                <button class="btn btn-ghost text-xs"
                        @onclick="() => Vm.CloseCategoryCommand.Execute()">
                    Cancel
                </button>

                @if (!Vm.CategoryIsNew)
                {
                    <button class="btn btn-secondary ml-auto whitespace-nowrap"
                            @onclick="() => Vm.SetCategoryActiveCommand.ExecuteAsync()">
                        @(Vm.CategoryIsActive ? "Retire" : "Restore")
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="px-6 py-5">
            <p class="m-0 text-sm text-ink/55">
                Pick a category to rename, reorder or retire, or add one. These are the
                chips offered when a stock item is edited, and the groups the stock table
                sorts by.
            </p>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public InventoryViewModel Vm { get; set; } = default!;

    /// <remarks>
    /// The same pair the suppliers list beside it uses, written out rather than shared:
    /// Tailwind scans source text, so these have to be whole literal strings.
    /// </remarks>
    private static string RowCss(bool on) =>
        on
            ? "flex w-full cursor-pointer items-center gap-2.5 border border-accent bg-accent-100 px-3 py-2 text-left font-[inherit]"
            : "flex w-full cursor-pointer items-center gap-2.5 border border-divider bg-transparent px-3 py-2 text-left font-[inherit] hover:border-ink/35";
}
